<template>
  <div class="swiper" ontouchstart="beginTouchGesture" ontouchmove="moveTouchGesture" ontouchend="finishTouchGesture">
    <div class="screen home-screen" show="{{ pageState.showHome }}">
      <div class="demo-page-mark" style="background-color: {{ pageState.accentColor }};"></div>
      <div class="demo-run-mark" style="background-color: {{ live.runMarkerColor }};"></div>
      <div class="goal-stars" style="transform: scale({{ goalStarsScale }});">
        <text class="goal-star goal-star-left" style="opacity: {{ goalStar1Opacity }}; transform: translateX({{ goalStar1X }}px) translateY({{ goalStar1Y }}px);">★</text>
        <text class="goal-star goal-star-top" style="opacity: {{ goalStar2Opacity }}; transform: translateX({{ goalStar2X }}px) translateY({{ goalStar2Y }}px);">★</text>
        <text class="goal-star goal-star-right" style="opacity: {{ goalStar3Opacity }}; transform: translateX({{ goalStar3X }}px) translateY({{ goalStar3Y }}px);">★</text>
        <text class="goal-stars-text" style="opacity: {{ goalMessageOpacity }};">30 秒目标达成</text>
      </div>
      <div class="app-head">
        <div class="title-block">
          <text class="app-title">小芽 · {{ dataSourceText }}</text>
        </div>
      </div>

      <div class="state-card">
        <div class="activity-row hero-activity-row">
          <div class="buddy-zone">
            <div class="activity-buddy-pop" style="opacity: {{ activityOpacity }}; transform: scale({{ activityScale }});">
              <div class="heart-buddy-pulse" style="transform: scale({{ heartScale }});">
                <div class="motion-buddy" style="transform: scale({{ buddyBreathScale }});">
                  <div class="buddy-sprout"><div class="buddy-leaf buddy-leaf-left"></div><div class="buddy-leaf buddy-leaf-right"></div></div>
                  <div class="buddy-eye-row"><div class="buddy-eye"></div><div class="buddy-eye"></div></div>
                  <div class="buddy-face-row"><div class="buddy-cheek"></div><text class="buddy-activity">{{ live.activityEmoji }}</text><div class="buddy-cheek"></div></div>
                </div>
              </div>
            </div>
            <div class="baseline-dots">
              <div class="baseline-dot" style="opacity: {{ baselineDot1Opacity }}; transform: translateY({{ baselineDot1Y }}px);"></div>
              <div class="baseline-dot" style="opacity: {{ baselineDot2Opacity }}; transform: translateY({{ baselineDot2Y }}px);"></div>
              <div class="baseline-dot" style="opacity: {{ baselineDot3Opacity }}; transform: translateY({{ baselineDot3Y }}px);"></div>
            </div>
          </div>
          <div class="activity-copy">
            <text class="activity-name" style="color: {{ live.activityColor }}; opacity: {{ activityOpacity }}; transform: scale({{ activityScale }});">{{ live.activityName }}</text>
            <div class="activity-chip-row">
              <text class="activity-chip">{{ live.elapsedText }}</text>
            </div>
          </div>
        </div>

        <div class="coach-box" style="background-color: {{ live.riskBgColor }}; transform: translateX({{ riskTranslateX }}px);">
          <div class="coach-head">
            <text class="coach-label" style="color: {{ live.riskColor }};">{{ live.riskTitle }}</text>
          </div>
        </div>
      </div>

      <div class="metric-strip">
        <div class="metric-card metric-heart">
          <text class="metric-icon">心率</text>
          <text class="metric-value heart-value" style="transform: scale({{ heartScale }});">{{ live.hrText }}</text>
        </div>
        <div class="metric-card metric-steps">
          <text class="metric-icon">步数</text>
          <text class="metric-value">{{ live.stepText }}</text>
        </div>
        <div class="metric-card metric-zone">
          <text class="metric-icon">强度</text>
          <text class="metric-value" style="color: {{ live.zoneInk }};">{{ live.zoneText }}</text>
        </div>
      </div>

      <div class="start-action">
        <div class="start-ring" style="opacity: {{ startRingOpacity }}; transform: scale({{ startRingScale }});" ontouchstart="queueTouchAction('toggleRunning')" ontouchend="finishTouchGesture" if="{{ startRingOpacity > 0 }}"><div class="start-ring-core"></div></div>
        <input class="primary-btn start-primary-btn" style="opacity: {{ startButtonOpacity }}; transform: scale({{ startButtonScale }});" type="button" value="{{ live.startButtonText }}" ontouchstart="queueTouchAction('toggleRunning')" ontouchend="finishTouchGesture" />
      </div>
    </div>

    <div class="screen ai-screen" show="{{ pageState.showCoach }}" if="{{ coachLoaded }}">
      <div class="demo-page-mark" style="background-color: {{ pageState.accentColor }};"></div>
      <div class="page-head compact-head">
        <text class="page-title">初筛</text>
      </div>

      <div class="coach-core-card">
        <div class="process-strip coach-process-strip">
          <div class="process-pulse" style="background-color: {{ processingStateColor }}; opacity: {{ motionPulseOpacity }}; transform: scaleX({{ motionPulseScale }});"></div>
          <div class="process-copy">
            <text class="process-title">{{ processingStateText }}</text>
          </div>
        </div>

        <div class="coach-view" if="{{ !coachToolsOpen }}">
          <div class="coach-live-row" style="background-color: {{ live.riskBgColor }}; transform: translateX({{ riskTranslateX }}px);">
            <div class="coach-live-orb" style="background-color: {{ live.riskBgColor }};">
              <div class="coach-orb-eye-row"><div class="coach-orb-eye"></div><div class="coach-orb-eye"></div></div>
              <text class="coach-live-mark" style="color: {{ live.activityColor }};">{{ live.activityEmoji }}</text>
            </div>
            <div class="coach-live-copy">
              <text class="coach-live-title" style="color: {{ live.activityColor }};">{{ live.activityName }} · {{ live.confidenceText }}</text>
            </div>
          </div>
          <div class="prob-row coach-prob-row" for="{{ live.coachClassRows }}">
            <text class="prob-name">{{ $item.name }}</text>
            <text class="prob-pct">{{ $item.percent }}%</text>
          </div>
          <div class="coach-advice-box"><text class="coach-advice" for="{{ live.coachTipLines }}">{{ $item }}</text></div>
        </div>

        <div class="coach-view" if="{{ coachToolsOpen }}">
          <div class="coach-selected-row">
            <text class="coach-selected-name">{{ currentSceneName }}</text>
          </div>
          <div class="coach-scene-grid">
            <input class="coach-scene-btn coach-scene-main" style="background-color: {{ sceneMixedBg }}; color: {{ sceneMixedColor }};" type="button" value="混合" ontouchstart="queueTouchAction('useMixed')" ontouchend="finishTouchGesture" />
            <input class="coach-scene-btn" style="background-color: {{ sceneRunningBg }}; color: {{ sceneRunningColor }};" type="button" value="跑步" ontouchstart="queueTouchAction('useRunning')" ontouchend="finishTouchGesture" />
            <input class="coach-scene-btn" style="background-color: {{ sceneFatigueBg }}; color: {{ sceneFatigueColor }};" type="button" value="疲劳跑" ontouchstart="queueTouchAction('useFatigue')" ontouchend="finishTouchGesture" />
            <input class="coach-scene-btn" style="background-color: {{ sceneJumpBg }}; color: {{ sceneJumpColor }};" type="button" value="跳绳" ontouchstart="queueTouchAction('useJump')" ontouchend="finishTouchGesture" />
            <input class="coach-scene-btn" style="background-color: {{ sceneStaticBg }}; color: {{ sceneStaticColor }};" type="button" value="静坐" ontouchstart="queueTouchAction('useStatic')" ontouchend="finishTouchGesture" />
            <input class="coach-scene-btn" style="background-color: {{ sceneRealBg }}; color: {{ sceneRealColor }};" type="button" value="真机" ontouchstart="queueTouchAction('useRealDevice')" ontouchend="finishTouchGesture" />
          </div>
        </div>
      </div>
      <input class="secondary-btn core-toggle-btn" show="{{ !isRunning }}" type="button" value="{{ coachToolsButtonText }}" ontouchstart="queueTouchAction('toggleCoachTools')" ontouchend="finishTouchGesture" />
    </div>

    <div class="screen timeline-screen" show="{{ pageState.showTimeline }}" if="{{ timelineLoaded }}">
      <div class="demo-page-mark" style="background-color: {{ pageState.accentColor }};"></div>
      <div class="page-head compact-head">
        <text class="page-title">时间线</text>
      </div>

      <div class="timeline-card core-timeline-card">
        <div class="timeline-summary" if="{{ !timelineReviewOpen }}">
          <div class="timeline-summary-orb"><text class="timeline-summary-value">{{ live.summarySegments }}</text><text class="timeline-summary-label">段</text></div>
          <text class="timeline-summary-active">{{ live.summaryActive }}</text>
        </div>

        <div class="timeline-list" if="{{ !timelineReviewOpen }}">
          <text class="empty timeline-empty" if="{{ live.timelineEmpty }}">运动后自动生成</text>
          <list class="segment-scroll" ontouchstart="beginTouchGesture" ontouchmove="moveTouchGesture" ontouchend="finishTouchGesture">
          <list-item type="segment" class="seg-row" for="{{ live.timelineRows }}">
            <div class="seg-dot" style="background-color: {{ $item.color }};"></div>
            <div class="seg-main">
              <div class="seg-title-row">
                <text class="seg-name">{{ $item.label }}</text><text class="seg-duration">{{ $item.duration }}</text>
              </div>
              <div class="seg-bar-row">
                <div class="seg-track"><div class="seg-fill" style="width: {{ $item.width }}px; background-color: {{ $item.color }};"></div></div>
              </div>
            </div>
          </list-item>
          </list>
        </div>

        <div class="core-review" if="{{ timelineReviewOpen }}">
          <div class="summary-stat-row core-summary-stat-row">
            <div class="summary-stat"><text class="stat-value">{{ live.summaryTotal }}</text><text class="stat-label">总时长</text></div>
            <div class="summary-stat"><text class="stat-value">{{ live.summaryActive }}</text><text class="stat-label">活动</text></div>
            <div class="summary-stat"><text class="stat-value">{{ live.summaryRisk }}</text><text class="stat-label">提醒</text></div>
          </div>
          <div class="review-title-row"><text class="review-note">{{ live.summaryActiveShare }}</text></div>
          <list class="core-ai-review" ontouchstart="beginTouchGesture" ontouchmove="moveTouchGesture" ontouchend="finishTouchGesture"><list-item class="review-copy-item" type="review-copy" for="{{ live.aiSummaryLines }}"><text class="core-ai-review-text">{{ $item }}</text></list-item></list>
          <input class="core-ai-review-btn" type="button" value="{{ live.aiSummaryButtonText }}" ontouchstart="queueTouchAction('refreshAiSummary')" ontouchend="finishTouchGesture" />
        </div>
      </div>
      <input class="secondary-btn core-toggle-btn" show="{{ !live.timelineEmpty && !isRunning }}" type="button" value="{{ timelineViewButtonText }}" ontouchstart="queueTouchAction('toggleTimelineReview')" ontouchend="finishTouchGesture" />
    </div>

    <div class="screen sync-screen" show="{{ pageState.showSyncReview }}" if="{{ syncLoaded }}">
      <div class="demo-page-mark" style="background-color: {{ pageState.accentColor }};"></div>
      <div class="page-head compact-head">
        <text class="page-title">协同</text>
      </div>

      <div class="review-tabs">
        <input class="review-tab review-tab-wide" style="background-color: {{ reviewSyncTabBg }}; color: {{ reviewSyncTabColor }};" type="button" value="同步" ontouchstart="queueTouchAction('showSyncPanel')" ontouchend="finishTouchGesture" />
        <input class="review-tab review-tab-wide" style="background-color: {{ reviewHistoryTabBg }}; color: {{ reviewHistoryTabColor }};" type="button" value="历史" ontouchstart="queueTouchAction('showHistoryPanel')" ontouchend="finishTouchGesture" />
        <input class="review-tab review-tab-wide" style="background-color: {{ reviewMoreTabBg }}; color: {{ reviewMoreTabColor }};" type="button" value="更多" ontouchstart="queueTouchAction('showDiagnosticPanel')" ontouchend="finishTouchGesture" />
      </div>

      <div class="sync-card core-sync-card" if="{{ showReviewPanelSync }}">
        <div class="process-strip sync-process-strip">
          <div class="process-pulse" style="background-color: {{ processingStateColor }}; opacity: {{ motionPulseOpacity }}; transform: scaleX({{ motionPulseScale }});"></div>
          <div class="process-copy">
            <text class="process-title">{{ processingStateText }}</text>
          </div>
        </div>
        <text class="precise-stamp" if="{{ preciseReviewReady }}" style="opacity: {{ preciseStampOpacity }}; transform: scale({{ preciseStampScale }});">已回填</text>
        <text class="precise-wait" if="{{ !preciseReviewReady }}">{{ syncFeedbackText }}</text>
        <div class="export-metrics core-export-metrics">
          <div class="export-metric"><text class="export-value">{{ exportTotalText }}</text><text class="export-label">时长</text></div>
          <div class="export-metric"><text class="export-value">{{ exportSegmentText }}</text><text class="export-label">片段</text></div>
          <div class="export-metric"><text class="export-value">{{ exportRiskText }}</text><text class="export-label">提醒</text></div>
        </div>
        <div class="sync-buttons core-sync-buttons" show="{{ !isRunning }}">
          <input class="mini-btn" style="opacity: {{ syncDiagnoseOpacity }};" type="button" value="{{ syncDiagnoseButtonText }}" ontouchstart="queueTouchAction('diagnoseSync')" ontouchend="finishTouchGesture" />
          <input class="mini-btn primary-mini" style="opacity: {{ syncSendOpacity }};" type="button" value="{{ syncSendButtonText }}" ontouchstart="queueTouchAction('sendLatestToPhone')" ontouchend="finishTouchGesture" />
        </div>
      </div>

      <div class="history-card core-fold-card" if="{{ showReviewPanelHistory }}">
        <text class="empty history-empty" if="{{ historyEmpty }}">暂无记录</text>
        <list class="history-scroll" if="{{ !historyEmpty }}" ontouchstart="beginTouchGesture" ontouchmove="moveTouchGesture" ontouchend="finishTouchGesture">
        <list-item type="history" class="history-row" for="{{ historyRows }}">
          <div class="history-main">
            <div class="history-title-row"><text class="history-title">{{ $item.title }}</text><text class="history-time">{{ $item.time }}</text></div>
          </div>
          <div class="history-side"><text class="history-score">{{ $item.score }}</text></div>
        </list-item>
        </list>
        <input class="fold-action-btn history-clear-btn" show="{{ !historyEmpty && !isRunning }}" style="background-color: {{ historyClearButtonBg }}; color: {{ historyClearButtonColor }};" type="button" value="{{ historyClearButtonText }}" ontouchstart="queueTouchAction('clearHistory')" ontouchend="finishTouchGesture" />
      </div>

      <div class="diagnostic-card core-fold-card" if="{{ showReviewPanelDiagnostic }}">
        <div class="more-tabs"><input class="more-tab" style="background-color: {{ moreDeviceTabBg }}; color: {{ moreDeviceTabColor }};" type="button" value="设备" ontouchstart="queueTouchAction('showDiagnosticPanel')" ontouchend="finishTouchGesture" /><input class="more-tab" style="background-color: {{ morePrivacyTabBg }}; color: {{ morePrivacyTabColor }};" type="button" value="隐私" ontouchstart="queueTouchAction('showPrivacyPanel')" ontouchend="finishTouchGesture" /></div>
        <list class="diagnostic-scroll" ontouchstart="beginTouchGesture" ontouchmove="moveTouchGesture" ontouchend="finishTouchGesture">
        <list-item type="diagnostic" class="diag-row" for="{{ diagnosticRows }}">
          <div class="diag-dot" style="background-color: {{ $item.color }};"></div>
          <text class="diag-name">{{ $item.name }}</text>
          <text class="diag-status">{{ $item.status }}</text>
        </list-item>
        </list>
        <input class="fold-action-btn" show="{{ !isRunning }}" type="button" value="{{ diagnosticButtonText }}" ontouchstart="queueTouchAction('runDiagnostics')" ontouchend="finishTouchGesture" />
      </div>

      <div class="privacy-card core-fold-card" if="{{ showReviewPanelPrivacy }}">
        <div class="more-tabs"><input class="more-tab" style="background-color: {{ moreDeviceTabBg }}; color: {{ moreDeviceTabColor }};" type="button" value="设备" ontouchstart="queueTouchAction('showDiagnosticPanel')" ontouchend="finishTouchGesture" /><input class="more-tab" style="background-color: {{ morePrivacyTabBg }}; color: {{ morePrivacyTabColor }};" type="button" value="隐私" ontouchstart="queueTouchAction('showPrivacyPanel')" ontouchend="finishTouchGesture" /></div>
        <div class="privacy-grid core-privacy-grid">
          <div class="privacy-item core-privacy-item"><text class="privacy-icon">端</text><text class="privacy-title">腕上</text></div>
          <div class="privacy-item core-privacy-item"><text class="privacy-icon">存</text><text class="privacy-title">本地</text></div>
          <div class="privacy-item core-privacy-item"><text class="privacy-icon">回</text><text class="privacy-title">回填</text></div>
        </div>
        <input class="fold-action-btn" show="{{ !isRunning }}" type="button" value="{{ motionEffectButtonText }}" ontouchstart="queueTouchAction('toggleMotionEffects')" ontouchend="finishTouchGesture" />
      </div>
    </div>

    <input class="global-stop" show="{{ isRunning && !pageState.showHome }}" type="button" value="停止训练" ontouchstart="queueTouchAction('stopSession')" ontouchend="finishTouchGesture" />
    <input class="nav-prev" type="button" value="桌面" ontouchstart="queueTouchAction('returnToDesktop')" ontouchend="finishTouchGesture" />
    <div class="page-dots" show="{{ !isRunning }}">
      <div class="page-dot" style="background-color: {{ pageState.dot0Color }}; transform: scale({{ pageState.dot0Scale }});"></div>
      <div class="page-dot" style="background-color: {{ pageState.dot1Color }}; transform: scale({{ pageState.dot1Scale }});"></div>
      <div class="page-dot" style="background-color: {{ pageState.dot2Color }}; transform: scale({{ pageState.dot2Scale }});"></div>
      <div class="page-dot" style="background-color: {{ pageState.dot3Color }}; transform: scale({{ pageState.dot3Scale }});"></div>
    </div>
    <input class="nav-next" type="button" value="下一页" ontouchstart="queueTouchAction('nextDemoPage')" ontouchend="finishTouchGesture" />
  </div>
</template>

<script>
import { MotionEngine, probabilityRows, formatSec, segmentRows } from '../../common/algorithm/motion_engine.js';
import { CooperativeMotionRunner } from '../../common/algorithm/cooperative_motion_runner.js';
import { MotionFxController, motionNeutralFrame } from '../../common/ui/motion_fx_controller.js';
import { TouchGesture } from '../../common/ui/touch_gesture.js';
import { LivePatchBuffer, PAGE_LIVE_KEYS } from '../../common/ui/live_patch.js';
import { InteractionScheduler } from '../../common/ui/interaction_scheduler.js';
import { CooperativeSteps } from '../../common/ui/cooperative_steps.js';
import { HISTORY_CLEAR_ACTIONS, historyClearAction, syncActionPermission, wrappedPageIndex } from '../../common/ui/interaction_state.js';
import { classEmoji, classColor, CLASS_NAMES, CLASS_BG, SAMPLE_PERIOD_MS } from '../../common/algorithm/config.js';
import { classifyHrZone, buildCoachTip, buildSummary, analyzeWorkoutRisk } from '../../common/algorithm/intensity_rules.js';
import { MockSensorProvider } from '../../common/sensor/mock_sensor_provider.js';
import { RealSensorProvider } from '../../common/sensor/real_sensor_provider.js';
import { getScenario } from '../../common/sensor/mock_scenarios.js';
import { HealthProvider, DATA_TYPES } from '../../common/sensor/health_provider.js';
import { saveSession, loadSessions, listSessions, clearSessions } from '../../common/storage/session_store.js';
import { diagnosePhoneLink, sendSessionToPhone, buildExportPreview, subscribePhoneMessages } from '../../common/sync/interconnect_sync.js';
import { PROCESSING_STATES, processingStateView, inspectPreciseResult, preciseResultAcceptance } from '../../common/sync/processing_state.js';
import { runDeviceDiagnostics } from '../../common/device/device_diagnostics.js';
import { getSessionStartPermission, getDiagnosticStartPermission, getRealTrainingPermission } from '../../common/device/operation_guard.js';
import { pulseWorkoutAlert, shouldShakeRiskCard } from '../../common/device/vibration_provider.js';
import { loadOptionalFeature } from '../../common/device/optional_features.js';
const brightness = loadOptionalFeature('brightness');
const battery = loadOptionalFeature('battery');
import { requestAiSummary, buildLocalAiSummary } from '../../common/ai/summary_provider.js';

const touchGesture = new TouchGesture();
const liveUpdates = new LivePatchBuffer(
  (vm) => PAGE_LIVE_KEYS[vm.pageState.index] || [],
  () => !touchGesture.state || Date.now() - touchGesture.state.time > 5000,
);
const interactionScheduler = new InteractionScheduler();
const inferenceSchedule = { schedule: (callback) => interactionScheduler.schedule(callback) };
let engine = null;
let inferenceRunner = null;
const stopWork = new CooperativeSteps();
let stopGeneration = 0;
let motionFx = null;
let unsubscribePhoneMessages = null;
let mockProvider = null;
let realProvider = null;
let healthProvider = null;
const AUTO_START_DEMO = false;
const AUTO_START_SCENE = 'mixed_workout';
const AUTO_START_OFFSET_SEC = 6.2;
const AUTO_PAGE_DEMO = false;
const GOAL_ACTIVE_SEC = 30;

let selectedSceneId = AUTO_START_SCENE;
let dataProviderMode = 'mock';
let lastResult = null;
let lastSample = null;
let sessionStartMs = 0;
let lastProbeLogMs = 0;
let lastAlertAtMs = 0;
let lastAlertKey = '';
let trendSamples = [];
let riskEvents = [];
let lastTrendSecond = -1;
let lastRiskEventAtMs = 0;
let lastRiskEventKey = '';
let lastSummarySnapshot = null;
let lastAnimatedActivityKey = '';
let goalActiveReached = false;
let demoPageTimer = null;
let demoStopTimer = null;
let demoSceneTimer = null;
let autoStartTimer = null;
let batteryPolicyGeneration = 0;
let pageDisposing = false;
let historyClearTimer = null;
let syncOperationTimer = null;
let syncOperationGeneration = 0;
let lastSyncSendAtMs = 0;
let aiSummaryTimer = null;
let aiSummaryGeneration = 0;
let diagnosticTimer = null;
let diagnosticGeneration = 0;

function clearDemoSessionTimers() {
  if (demoStopTimer) clearTimeout(demoStopTimer);
  if (demoSceneTimer) clearTimeout(demoSceneTimer);
  demoStopTimer = null;
  demoSceneTimer = null;
}

function setTrainingScreenOn(keep) {
  const enabled = !!keep;
  try {
    if (!brightness || !brightness.setKeepScreenOn) {
      console.log("VMC_SCREEN_KEEP_ON unavailable");
      return false;
    }
    brightness.setKeepScreenOn({
      keepScreenOn: enabled,
      success() {
        console.log("VMC_SCREEN_KEEP_ON enabled=" + enabled);
      },
      fail(data, code) {
        console.log("VMC_SCREEN_KEEP_ON_FAIL enabled=" + enabled + " code=" + code);
      },
    });
    return true;
  } catch (e) {
    console.log("VMC_SCREEN_KEEP_ON_ERROR enabled=" + enabled + " error=" + (e && e.message ? e.message : e));
    return false;
  }
}

function pct(v) {
  return `${Math.round((v || 0) * 100)}%`;
}

function finiteNumber(value, fallback) {
  const n = Number(value);
  return Number.isFinite(n) ? n : fallback;
}

function secFromNow(sample) {
  if (!sample || !sessionStartMs) return 0;
  return Math.max(0, Math.floor((sample.timeStamp - sessionStartMs) / 1000));
}

function initialRows() {
  return probabilityRows(new Array(CLASS_NAMES.length).fill(0));
}

function topCoachRows(rows) {
  return (rows || [])
    .slice()
    .sort((left, right) => Number(right.percent || 0) - Number(left.percent || 0))
    .slice(0, 2);
}

function twoDigit(n) {
  return n < 10 ? `0${n}` : `${n}`;
}

function formatSavedAt(ms) {
  const d = new Date(ms || Date.now());
  return `${twoDigit(d.getMonth() + 1)}/${twoDigit(d.getDate())} ${twoDigit(d.getHours())}:${twoDigit(d.getMinutes())}`;
}

const SCENE_WAVES = {
  mixed_workout: [8, 12, 30, 42, 26, 14, 38, 46, 24, 12, 32, 40, 20, 8],
  running: [12, 34, 18, 42, 16, 38, 20, 44, 18, 40, 16, 36, 20, 12],
  fatigue_running: [10, 28, 18, 34, 22, 40, 26, 44, 30, 46, 34, 42, 28, 14],
  jump_rope: [8, 44, 10, 46, 8, 42, 12, 46, 8, 44, 10, 46, 8, 12],
  static: [8, 10, 9, 11, 8, 10, 9, 12, 8, 9, 10, 8, 9, 8],
  real_device: [10, 14, 12, 20, 16, 26, 18, 32, 22, 28, 20, 34, 24, 18],
};

function scenePreviewRows(sceneId) {
  const values = SCENE_WAVES[sceneId] || SCENE_WAVES.mixed_workout;
  const sceneColors = {
    running: '#16755A',
    fatigue_running: '#EF4444',
    jump_rope: '#2563EB',
    static: '#94A3B8',
    real_device: '#111111',
  };
  const mixedColors = ['#94A3B8', '#16755A', '#16755A', '#16755A', '#2563EB', '#2563EB', '#DC2626', '#DC2626', '#16A34A', '#16A34A', '#7C3AED', '#7C3AED', '#94A3B8', '#94A3B8'];
  return values.map((height, idx) => ({
    height,
    color: sceneId === 'mixed_workout' ? mixedColors[idx] : (sceneColors[sceneId] || '#16755A'),
  }));
}

function sceneHint(sceneId) {
  const hints = {
    mixed_workout: '多动作连续切换',
    running: '稳定跑步节奏',
    fatigue_running: '后程强度上升',
    jump_rope: '高频周期动作',
    static: '低运动基线',
    real_device: '读取腕上数据',
  };
  return hints[sceneId] || '自动识别';
}

function zoneBarWidth(level) {
  if (level === 'easy') return 82;
  if (level === 'aerobic') return 168;
  if (level === 'hard') return 254;
  if (level === 'peak') return 340;
  return 18;
}

function compactWatchSummary(text) {
  const clean = String(text || '').replace(/\s+/g, ' ').trim();
  if (!clean) return '训练后生成一句建议。';
  const firstStop = clean.search(/[。！？]/);
  if (firstStop >= 14 && firstStop <= 48) return clean.slice(0, firstStop + 1);
  return clean.length > 48 ? clean.slice(0, 48) + '…' : clean;
}

function watchDiagnosticRows(rows) {
  const shortNames = {
    '屏幕/设备': '屏幕',
    '电量/功耗基线': '电量/功耗',
    'service.health': '健康',
    '真实 ACC': 'ACC',
    '真实步数': '步数',
    '腕上振动': '振动',
    '真实 GYRO': 'GYRO',
    '真机诊断': '诊断',
  };
  return (rows || []).slice(0, 7).map((row) => ({
    name: shortNames[row.name] || row.name,
    status: row.status || '待测',
    detail: row.detail || '',
    color: row.status === '通过' ? '#22C55E' : (row.status === '失败' ? '#EF4444' : '#6E7FEA'),
  }));
}

function diagnosticOverview(rows) {
  const list = rows || [];
  const passed = list.filter((row) => row.status === '通过').length;
  const boundary = list.filter((row) => row.status === '边界').length;
  const total = Math.max(1, list.length);
  return {
    text: list.length ? `${passed} 通过 · ${boundary} 边界` : '待检测',
    width: list.length ? Math.max(18, Math.round(248 * passed / total)) : 18,
  };
}

function historyRowsFromSessions(items) {
  return (items || []).slice(0, 4).map((it) => {
    const summary = it.summary || {};
    const sceneName = it.sceneName || (it.sceneId === 'real_device' ? '真机采集' : getScenario(it.sceneId || 'mixed_workout').name);
    const total = Math.max(1, Number(summary.totalSec || 0));
    const active = Math.max(0, Number(summary.activeSec || 0));
    return {
      title: sceneName,
      time: formatSavedAt(it.savedAt),
      activeText: formatSec(active),
      activeWidth: Math.max(8, Math.round(126 * Math.min(1, active / total))),
      segmentText: `${summary.segmentCount || 0} 段`,
      score: summary.zoneLabel || (summary.bpm && summary.bpm !== '--' ? `${summary.bpm}` : '--'),
    };
  });
}

function activityShareRowsFromSummary(summary) {
  const byClass = summary && summary.byClass ? summary.byClass : {};
  const totalSec = Math.max(1, summary && summary.totalSec ? summary.totalSec : 0);
  const rows = [];
  CLASS_NAMES.forEach((name, idx) => {
    const sec = Math.round(byClass[idx] || byClass[String(idx)] || 0);
    if (sec <= 0) return;
    const share = Math.max(0, Math.min(1, sec / totalSec));
    rows.push({
      idx,
      sec,
      name: `${classEmoji(idx)} ${name}`,
      duration: formatSec(sec),
      percent: `${Math.round(share * 100)}%`,
      width: Math.max(8, Math.round(210 * share)),
      color: idx === CLASS_BG ? '#CBD5E1' : classColor(idx),
    });
  });
  rows.sort((a, b) => b.sec - a.sec);
  if (rows.length === 0) {
    return [{ name: '等待数据', duration: '--', percent: '--', width: 8, color: '#E5E7EB' }];
  }
  return rows.slice(0, 4);
}

function intensityTrendRowsFromSamples(samples) {
  const src = (samples || []).slice(-14);
  const rows = src.map((it) => {
    const bpm = it && it.bpm ? it.bpm : 0;
    const height = bpm > 0 ? Math.max(8, Math.min(50, Math.round(8 + ((bpm - 60) / 110) * 42))) : 6;
    return {
      height,
      color: it && it.color ? it.color : '#E5E7EB',
      label: bpm ? `${Math.round(bpm)}` : '--',
    };
  });
  while (rows.length < 14) rows.unshift({ height: 6, color: '#E5E7EB', label: '--' });
  return rows;
}

function riskRowsFromEvents(events) {
  return (events || []).slice(-3).reverse().map((it) => ({
    time: it.time,
    title: it.title,
    message: it.message,
    color: it.color,
  }));
}

function activeShareText(summary) {
  const total = summary && summary.totalSec ? summary.totalSec : 0;
  const active = summary && summary.activeSec ? summary.activeSec : 0;
  if (!total) return '活跃 --';
  return `活跃 ${Math.round((active / Math.max(1, total)) * 100)}%`;
}

const PAGE_NAMES = ["01 首页", "02 腕上教练", "03 动作时间线", "04 同步复盘"];
const PAGE_COLORS = ["#3EBE9B", "#62A9E8", "#6E7FEA", "#D66B8C"];

function pageStateFor(index) {
  const safeIndex = Math.max(0, Math.min(PAGE_NAMES.length - 1, Number(index) || 0));
  return {
    index: safeIndex,
    pageNo: PAGE_NAMES[safeIndex],
    accentColor: PAGE_COLORS[safeIndex],
    showHome: safeIndex === 0,
    showCoach: safeIndex === 1,
    showTimeline: safeIndex === 2,
    showSyncReview: safeIndex === 3,
    dot0Color: safeIndex === 0 ? PAGE_COLORS[0] : '#CFE3DA',
    dot1Color: safeIndex === 1 ? PAGE_COLORS[1] : '#CFE3DA',
    dot2Color: safeIndex === 2 ? PAGE_COLORS[2] : '#CFE3DA',
    dot3Color: safeIndex === 3 ? PAGE_COLORS[3] : '#CFE3DA',
    dot0Scale: safeIndex === 0 ? 1.28 : 1,
    dot1Scale: safeIndex === 1 ? 1.28 : 1,
    dot2Scale: safeIndex === 2 ? 1.28 : 1,
    dot3Scale: safeIndex === 3 ? 1.28 : 1,
  };
}

function createInitialLiveState() {
  return {
    runStatusText: "待开始",
    runMarkerColor: "#94A3B8",
    alertStatusText: "提醒开启",
    startButtonText: "开始",
    activityEmoji: "动",
    activityName: "待机",
    activityColor: "#111111",
    confidenceText: "--",
    elapsedText: "0:00",
    hrText: "--",
    stepText: "0",
    accText: "等待动作数据",
    zoneText: "--",
    zoneColor: "#111111",
    zoneInk: "#111111",
    zoneWidth: 18,
    coachTip: "识别动作，提醒运动强度",
    coachTipLines: ["识别动作", "提醒运动强度"],
    riskTitle: "状态正常",
    riskMessage: "未发现疲劳或异常强度。",
    riskColor: "#16A34A",
    riskBgColor: "#F0FDF4",
    classRows: initialRows(),
    coachClassRows: topCoachRows(initialRows()),
    timelineRows: [],
    timelineEmpty: true,
    summaryTotal: "0:00",
    summaryActive: "0:00",
    summarySegments: "0",
    summaryTip: "停止训练后自动保存到本地历史。",
    summaryActiveShare: "活跃 --",
    summaryRisk: "无风险",
    aiSummaryTitle: "等待训练",
    aiSummaryText: "训练后生成一句建议。",
    aiSummaryLines: ["训练后生成一句建议。"],
    aiSummarySource: "本地总结",
    aiSummaryButtonText: "生成建议",
    activityShareRows: activityShareRowsFromSummary({}),
    intensityTrendRows: intensityTrendRowsFromSamples([]),
    riskRows: [],
    riskEmpty: true,
  };
}

function patchLive(vm, patch) {
  const current = liveUpdates.current(vm) || createInitialLiveState();
  const next = Object.assign({}, current, patch || {});
  // Bright activity colors remain on bars; use darker ink for small-screen text.
  const zoneInk = { '#38BDF8': '#176289', '#22C55E': '#16755A', '#F97316': '#A34310', '#EF4444': '#B3261E' };
  next.zoneInk = zoneInk[String(next.zoneColor).toUpperCase()] || next.zoneColor;
  // A single actionable clause stays readable without squeezing the watch font.
  if (!current.coachTipLines || (patch && patch.coachTip !== undefined && patch.coachTip !== current.coachTip)) {
    const coachClauses = String(next.coachTip || '').split(/[，。！？]/).filter(Boolean);
    next.coachTip = coachClauses.length ? coachClauses[coachClauses.length - 1] : '';
    next.coachTipLines = [next.coachTip.slice(0, 10), next.coachTip.slice(10)].filter(Boolean);
  }
  if (!current.aiSummaryLines || next.aiSummaryText !== current.aiSummaryText)
    next.aiSummaryLines = String(next.aiSummaryText || '').match(/.{1,11}/g) || [];
  return liveUpdates.commit(vm, next);
}

export default {
  private: {
    pageState: pageStateFor(0),
    coachLoaded: false,
    timelineLoaded: false,
    syncLoaded: false,
    currentSceneName: "混合训练",
    sceneDesc: sceneHint("mixed_workout"),
    scenePreviewRows: scenePreviewRows("mixed_workout"),
    dataSourceText: "演示",
    storageStatusText: "读取中",
    isRunning: false,
    isFinalizing: false,
    live: createInitialLiveState(),
    serviceHealthText: "Mock 兜底",
    historyRows: [],
    historyEmpty: true,
    historyClearArmed: false,
    historyClearBusy: false,
    historyClearButtonText: "清空",
    historyClearButtonBg: "#E3F5EE",
    historyClearButtonColor: "#16755A",
    syncStatusText: "未检测",
    syncFeedbackText: "待回填",
    syncDiagnosing: false,
    syncSending: false,
    syncDiagnoseButtonText: "检测",
    syncSendButtonText: "发送",
    syncDiagnoseOpacity: 1,
    syncSendOpacity: 1,
    exportStatusText: "等待历史",
    exportPreviewText: "停止训练后可同步摘要到手机端。",
    exportTotalText: "--",
    exportSegmentText: "--",
    exportRiskText: "--",
    diagnosticRows: watchDiagnosticRows([
      { name: "真机诊断", status: "待测", detail: "点击检测" },
      { name: "真实 GYRO", status: "边界", detail: "需原生适配" },
    ]),
    diagnosticSummaryText: "待检测",
    diagnosticPassWidth: 18,
    diagnosticButtonText: "检测",
    isDiagnosing: false,
    aiSummaryBusy: false,
    coachToolsOpen: false,
    coachToolsButtonText: "场景",
    timelineReviewOpen: false,
    timelineViewButtonText: "复盘",
    showReviewPanelSync: true,
    showReviewPanelHistory: false,
    showReviewPanelDiagnostic: false,
    showReviewPanelPrivacy: false,
    reviewSyncTabBg: "#22312D",
    reviewSyncTabColor: "#FFFFFF",
    reviewHistoryTabBg: "#FFFFFF",
    reviewHistoryTabColor: "#5F6F69",
    reviewMoreTabBg: "#FFFFFF",
    reviewMoreTabColor: "#5F6F69",
    moreDeviceTabBg: "#22312D",
    moreDeviceTabColor: "#FFFFFF",
    morePrivacyTabBg: "#FFFFFF",
    morePrivacyTabColor: "#5F6F69",
    processingStateKey: PROCESSING_STATES.WATCH_SCREENING,
    processingStateText: "腕上初筛",
    processingStateDetail: "端侧轻量识别，不上传原始流",
    processingStateColor: "#3E9E82",
    preciseReviewReady: false,
    preciseReviewText: "尚未收到手机精确结果",
    pageVisible: false,
    motionEffectsEnabled: false,
    motionEffectsPaused: true,
    animationPowerSave: false,
    baselineActive: false,
    motionPulseScale: 1,
    motionPulseOpacity: 0.56,
    buddyBreathScale: 1,
    startRingScale: 0.72,
    startRingOpacity: 0,
    startButtonScale: 1,
    startButtonOpacity: 1,
    baselineDot1Y: 0,
    baselineDot2Y: 0,
    baselineDot3Y: 0,
    baselineDot1Opacity: 0,
    baselineDot2Opacity: 0,
    baselineDot3Opacity: 0,
    activityScale: 1,
    activityOpacity: 1,
    heartScale: 1,
    riskTranslateX: 0,
    goalStarsScale: 0.72,
    goalStar1X: 0,
    goalStar1Y: 4,
    goalStar2X: 0,
    goalStar2Y: 4,
    goalStar3X: 0,
    goalStar3Y: 4,
    goalStar1Opacity: 0,
    goalStar2Opacity: 0,
    goalStar3Opacity: 0,
    goalMessageOpacity: 0,
    preciseStampScale: 1,
    preciseStampOpacity: 0,
    syncDot1Opacity: 1,
    syncDot2Opacity: 0.34,
    syncDot3Opacity: 0.34,
    motionPolicyText: "动效待机",
    motionPolicyDetail: "页面显示时启用轻量动效；低电量且未充电时自动暂停。",
    motionEffectButtonText: "恢复动效",
    batteryLevelText: "电量未知",
    goalActiveText: "本次活跃目标 30 秒",
    sceneMixedBg: "#DFF6EE",
    sceneMixedColor: "#16755A",
    sceneRunningBg: "#F0F5F2",
    sceneRunningColor: "#42514B",
    sceneFatigueBg: "#F0F5F2",
    sceneFatigueColor: "#42514B",
    sceneJumpBg: "#F0F5F2",
    sceneJumpColor: "#42514B",
    sceneStaticBg: "#F0F5F2",
    sceneStaticColor: "#42514B",
    sceneRealBg: "#F0F5F2",
    sceneRealColor: "#42514B",
  },

  onReady() {
    pageDisposing = false;
    batteryPolicyGeneration += 1;
    setTrainingScreenOn(false);
    engine = new MotionEngine();
    inferenceRunner = new CooperativeMotionRunner(engine, inferenceSchedule);
    motionFx = new MotionFxController();
    mockProvider = new MockSensorProvider();
    realProvider = new RealSensorProvider();
    unsubscribePhoneMessages = subscribePhoneMessages((payload) => this.handlePhoneMessage(payload));
    this.loadSessionHistory();
    this.applyExportPreview();
    this.applyScene(AUTO_START_SCENE, true);
    if (AUTO_START_DEMO) {
      if (autoStartTimer) clearTimeout(autoStartTimer);
      autoStartTimer = setTimeout(() => {
        autoStartTimer = null;
        if (!pageDisposing && !this.isRunning && mockProvider) {
          console.log(`VMC_AUTO_START_MOCK scene=${AUTO_START_SCENE} startOffsetSec=${AUTO_START_OFFSET_SEC}`);
          this.startSession(AUTO_START_OFFSET_SEC);
        }
      }, 800);
    }
    if (AUTO_PAGE_DEMO) this.startDemoCarousel();
  },

  onShow() {
    this.pageVisible = true;
    patchLive(this, this.inferenceViewPatch());
    liveUpdates.flush(this);
    setTrainingScreenOn(this.isRunning);
    this.refreshBatteryPolicy();
    this.refreshMotionEffects();
  },

  onHide() {
    touchGesture.cancel();
    this.pageVisible = false;
    this.resetHistoryClear();
    batteryPolicyGeneration += 1;
    setTrainingScreenOn(false);
    if (motionFx) motionFx.pause();
    this.motionEffectsPaused = true;
    this.applyMotionFrame(motionNeutralFrame(this.preciseReviewReady));
    this.motionPolicyText = this.animationPowerSave ? "低电量省电" : "动效已暂停";
  },

  onDestroy() {
    touchGesture.cancel();
    this.pageVisible = false;
    this.motionEffectsPaused = true;
    pageDisposing = true;
    stopGeneration += 1;
    stopWork.drain();
    batteryPolicyGeneration += 1;
    setTrainingScreenOn(false);
    if (motionFx) motionFx.pause();
    this.applyMotionFrame(motionNeutralFrame(this.preciseReviewReady));
    if (unsubscribePhoneMessages) unsubscribePhoneMessages();
    unsubscribePhoneMessages = null;
    if (inferenceRunner) inferenceRunner.cancel();
    if (mockProvider) mockProvider.stop();
    if (realProvider) realProvider.stop();
    if (healthProvider) healthProvider.stop();
    if (demoPageTimer) clearInterval(demoPageTimer);
    demoPageTimer = null;
    if (autoStartTimer) clearTimeout(autoStartTimer);
    autoStartTimer = null;
    if (historyClearTimer) clearTimeout(historyClearTimer);
    historyClearTimer = null;
    if (syncOperationTimer) clearTimeout(syncOperationTimer);
    syncOperationTimer = null;
    syncOperationGeneration += 1;
    if (aiSummaryTimer) clearTimeout(aiSummaryTimer);
    aiSummaryTimer = null;
    aiSummaryGeneration += 1;
    if (diagnosticTimer) clearTimeout(diagnosticTimer);
    diagnosticTimer = null;
    diagnosticGeneration += 1;
    clearDemoSessionTimers();
  },

  beginTouchGesture(event) {
    interactionScheduler.touch();
    touchGesture.begin(event, '', Date.now());
  },

  returnToDesktop() {
    touchGesture.cancel();
    this.$app.exit();
  },

  onBackPress() {
    this.returnToDesktop();
    return true;
  },

  queueTouchAction(action, event) {
    interactionScheduler.touch();
    touchGesture.begin(event, action, Date.now());
  },

  moveTouchGesture(event) {
    interactionScheduler.touch();
    this.applyTouchResult(touchGesture.move(event));
  },

  finishTouchGesture(event) {
    interactionScheduler.touch();
    this.applyTouchResult(touchGesture.end(event, Date.now()));
    liveUpdates.flush(this);
  },

  applyTouchResult(result) {
    if (!result || !this.pageVisible) return;
    if (result.pageDelta) {
      this.setDemoPage(wrappedPageIndex(this.pageState.index, result.pageDelta, PAGE_NAMES.length));
      console.log(`VMC_GESTURE_PAGE index=${this.pageState.index}`);
    } else if (result.action && typeof this[result.action] === 'function') {
      this[result.action]();
    }
  },

  setDemoPage(index) {
    touchGesture.cancel();
    if (this.pageState && this.pageState.index === 3 && Number(index) !== 3) this.resetHistoryClear();
    if (Number(index) === 1) this.coachLoaded = true;
    if (Number(index) === 2) this.timelineLoaded = true;
    if (Number(index) === 3) this.syncLoaded = true;
    const nextPage = pageStateFor(index);
    Object.keys(nextPage).forEach((key) => {
      if (this.pageState[key] !== nextPage[key]) this.pageState[key] = nextPage[key];
    });
    patchLive(this, this.inferenceViewPatch());
    liveUpdates.flush(this);
    this.updateMotionChannels();
  },

  previousDemoPage() {
    const previous = wrappedPageIndex(this.pageState.index, -1, PAGE_NAMES.length);
    this.setDemoPage(previous);
    console.log(`VMC_DEMO_PAGE_MANUAL index=${this.pageState.index}`);
  },

  nextDemoPage() {
    const next = wrappedPageIndex(this.pageState.index, 1, PAGE_NAMES.length);
    this.setDemoPage(next);
    console.log(`VMC_DEMO_PAGE_MANUAL index=${this.pageState.index}`);
  },

  startDemoCarousel() {
    if (demoPageTimer) clearInterval(demoPageTimer);
    clearDemoSessionTimers();
    this.setDemoPage(0);
    const pageSchedule = [0, 1, 2, 3];
    let cursor = 0;
    demoPageTimer = setInterval(() => {
      cursor = (cursor + 1) % pageSchedule.length;
      this.setDemoPage(pageSchedule[cursor]);
      console.log(`VMC_DEMO_PAGE index=${this.pageState.index}`);
    }, 2400);
    demoSceneTimer = setTimeout(() => {
      if (this.isRunning) {
        // The carousel intentionally changes the active Mock stream while a
        // demo session is running. User-triggered scene changes remain blocked
        // by applyScene(), but this controlled transition must bypass that guard.
        this.applyScene('fatigue_running', true);
        console.log('VMC_DEMO_SCENE scene=fatigue_running');
      }
    }, 10500);
    demoStopTimer = setTimeout(() => {
      if (this.isRunning) {
        console.log('VMC_DEMO_AUTO_STOP');
        this.stopSession();
      }
    }, 39000);
  },

  toggleCoachTools() {
    this.coachToolsOpen = !this.coachToolsOpen;
    this.coachToolsButtonText = this.coachToolsOpen ? "实时" : "场景";
  },

  toggleTimelineReview() {
    this.timelineReviewOpen = !this.timelineReviewOpen;
    this.timelineViewButtonText = this.timelineReviewOpen ? "时间线" : "复盘";
  },

  setReviewPanel(name) {
    if (name !== 'history') this.resetHistoryClear();
    this.showReviewPanelSync = name === 'sync';
    this.showReviewPanelHistory = name === 'history';
    this.showReviewPanelDiagnostic = name === 'diagnostic';
    this.showReviewPanelPrivacy = name === 'privacy';
    const moreActive = name === 'diagnostic' || name === 'privacy';
    this.reviewSyncTabBg = name === 'sync' ? '#22312D' : '#FFFFFF';
    this.reviewSyncTabColor = name === 'sync' ? '#FFFFFF' : '#5F6F69';
    this.reviewHistoryTabBg = name === 'history' ? '#22312D' : '#FFFFFF';
    this.reviewHistoryTabColor = name === 'history' ? '#FFFFFF' : '#5F6F69';
    this.reviewMoreTabBg = moreActive ? '#22312D' : '#FFFFFF';
    this.reviewMoreTabColor = moreActive ? '#FFFFFF' : '#5F6F69';
    this.moreDeviceTabBg = name === 'diagnostic' ? '#DFF6EE' : '#FFFFFF';
    this.moreDeviceTabColor = name === 'diagnostic' ? '#16755A' : '#5F6F69';
    this.morePrivacyTabBg = name === 'privacy' ? '#EAF5FF' : '#FFFFFF';
    this.morePrivacyTabColor = name === 'privacy' ? '#25658B' : '#5F6F69';
    this.updateMotionChannels();
  },

  showSyncPanel() { this.setReviewPanel('sync'); },
  showHistoryPanel() { this.setReviewPanel('history'); },
  showDiagnosticPanel() { this.setReviewPanel('diagnostic'); },
  showPrivacyPanel() { this.setReviewPanel('privacy'); },

  resetHistoryClear() {
    if (historyClearTimer) clearTimeout(historyClearTimer);
    historyClearTimer = null;
    if (this.historyClearBusy) return;
    this.historyClearArmed = false;
    this.historyClearButtonText = '清空';
    this.historyClearButtonBg = '#E3F5EE';
    this.historyClearButtonColor = '#16755A';
  },

  setSceneSelection(sceneId) {
    const selectedBg = '#DFF6EE';
    const selectedColor = '#16755A';
    const idleBg = '#F0F5F2';
    const idleColor = '#42514B';
    const pairs = [
      ['Mixed', 'mixed_workout'],
      ['Running', 'running'],
      ['Fatigue', 'fatigue_running'],
      ['Jump', 'jump_rope'],
      ['Static', 'static'],
      ['Real', 'real_device'],
    ];
    pairs.forEach((pair) => {
      this[`scene${pair[0]}Bg`] = pair[1] === sceneId ? selectedBg : idleBg;
      this[`scene${pair[0]}Color`] = pair[1] === sceneId ? selectedColor : idleColor;
    });
  },

  setProcessingState(key, detail) {
    const view = processingStateView(key, detail);
    this.processingStateKey = view.key;
    this.processingStateText = view.text;
    this.processingStateDetail = view.detail;
    this.processingStateColor = view.color;
    this.updateMotionChannels();
  },

  applyMotionFrame(frame) {
    const safe = frame || {};
    const assignNumber = (sourceKey, targetKey, fallback) => {
      if (!Object.prototype.hasOwnProperty.call(safe, sourceKey)) return;
      const value = Number(safe[sourceKey]);
      const next = Number.isFinite(value) ? value : fallback;
      if (this[targetKey] !== next) this[targetKey] = next;
    };
    assignNumber('pulseScale', 'motionPulseScale', 1);
    assignNumber('pulseOpacity', 'motionPulseOpacity', 0.56);
    assignNumber('buddyBreathScale', 'buddyBreathScale', 1);
    assignNumber('startRingScale', 'startRingScale', 0.72);
    assignNumber('startRingOpacity', 'startRingOpacity', 0);
    assignNumber('startButtonScale', 'startButtonScale', 1);
    assignNumber('startButtonOpacity', 'startButtonOpacity', 1);
    assignNumber('baselineDot1Y', 'baselineDot1Y', 0);
    assignNumber('baselineDot2Y', 'baselineDot2Y', 0);
    assignNumber('baselineDot3Y', 'baselineDot3Y', 0);
    assignNumber('baselineDot1Opacity', 'baselineDot1Opacity', 0);
    assignNumber('baselineDot2Opacity', 'baselineDot2Opacity', 0);
    assignNumber('baselineDot3Opacity', 'baselineDot3Opacity', 0);
    assignNumber('activityScale', 'activityScale', 1);
    assignNumber('activityOpacity', 'activityOpacity', 1);
    assignNumber('heartScale', 'heartScale', 1);
    assignNumber('riskTranslateX', 'riskTranslateX', 0);
    assignNumber('goalStarsScale', 'goalStarsScale', 0.72);
    assignNumber('goalStar1X', 'goalStar1X', 0);
    assignNumber('goalStar1Y', 'goalStar1Y', 4);
    assignNumber('goalStar2X', 'goalStar2X', 0);
    assignNumber('goalStar2Y', 'goalStar2Y', 4);
    assignNumber('goalStar3X', 'goalStar3X', 0);
    assignNumber('goalStar3Y', 'goalStar3Y', 4);
    assignNumber('goalStar1Opacity', 'goalStar1Opacity', 0);
    assignNumber('goalStar2Opacity', 'goalStar2Opacity', 0);
    assignNumber('goalStar3Opacity', 'goalStar3Opacity', 0);
    assignNumber('goalMessageOpacity', 'goalMessageOpacity', 0);
    assignNumber('preciseStampScale', 'preciseStampScale', 1);
    assignNumber('preciseStampOpacity', 'preciseStampOpacity', this.preciseReviewReady ? 1 : 0);
    assignNumber('dot1Opacity', 'syncDot1Opacity', 1);
    assignNumber('dot2Opacity', 'syncDot2Opacity', 0.34);
    assignNumber('dot3Opacity', 'syncDot3Opacity', 0.34);
  },

  updateMotionChannels() {
    if (!motionFx || !this.pageVisible || !this.motionEffectsEnabled) return;
    const pageIndex = this.pageState ? this.pageState.index : -1;
    const onHome = pageIndex === 0;
    const onSync = pageIndex === 3 && this.showReviewPanelSync;
    const bpm = lastSample && lastSample.heartRate ? lastSample.heartRate : 0;
    motionFx.setHeartRate(bpm);
    motionFx.setChannels({
      breathe: onHome && !this.isRunning,
      baseline: onHome && this.isRunning && this.baselineActive,
      sync: onSync && this.processingStateKey === PROCESSING_STATES.AWAITING_PRECISE,
      heart: onHome && this.isRunning && bpm > 0,
    });
  },

  triggerMotionEffect(name) {
    if (!motionFx || !motionFx.isRunning() || !this.pageVisible) return false;
    const pageIndex = this.pageState ? this.pageState.index : -1;
    if ((name === 'start' || name === 'activity' || name === 'goal') && pageIndex !== 0) return false;
    if (name === 'risk' && pageIndex !== 0 && pageIndex !== 1) return false;
    if (name === 'precise' && (pageIndex !== 3 || !this.showReviewPanelSync)) return false;
    if (name === 'start') return motionFx.triggerStartRing();
    if (name === 'activity') return motionFx.triggerActivityPop(220);
    if (name === 'risk') return motionFx.triggerRiskShake();
    if (name === 'goal') return motionFx.triggerGoalStars();
    if (name === 'precise') return motionFx.triggerPreciseStamp();
    return false;
  },

  refreshMotionEffects() {
    if (!motionFx) motionFx = new MotionFxController();
    const shouldRun = Boolean(this.pageVisible && this.motionEffectsEnabled && !this.animationPowerSave);
    if (!shouldRun) {
      motionFx.pause();
      this.motionEffectsPaused = true;
      this.applyMotionFrame(motionNeutralFrame(this.preciseReviewReady));
      this.motionPolicyText = this.animationPowerSave
        ? "低电量省电"
        : (this.motionEffectsEnabled ? "动效已暂停" : "动效已关闭");
      return;
    }
    this.motionEffectsPaused = false;
    this.motionPolicyText = "轻量动效";
    if (!motionFx.isRunning()) {
      motionFx.start((frame) => this.applyMotionFrame(frame));
      motionFx.setPreciseVisible(this.preciseReviewReady);
    }
    this.updateMotionChannels();
  },

  toggleMotionEffects() {
    this.motionEffectsEnabled = !this.motionEffectsEnabled;
    this.motionEffectButtonText = this.motionEffectsEnabled ? "暂停动效" : "恢复动效";
    this.refreshMotionEffects();
  },

  refreshBatteryPolicy() {
    const policyGeneration = ++batteryPolicyGeneration;
    if (!battery || !battery.getStatus) {
      if (pageDisposing || policyGeneration !== batteryPolicyGeneration) return;
      this.batteryLevelText = "电量未知";
      this.animationPowerSave = false;
      this.motionPolicyDetail = "电量接口不可用；页面隐藏时仍会暂停持续动效。";
      this.refreshMotionEffects();
      return;
    }
    try {
      battery.getStatus({
        success: (data) => {
          if (pageDisposing || policyGeneration !== batteryPolicyGeneration) return;
          const rawLevel = Number(data && data.level);
          const level = Number.isFinite(rawLevel) ? Math.max(0, Math.min(1, rawLevel > 1 ? rawLevel / 100 : rawLevel)) : null;
          const charging = Boolean(data && data.charging);
          this.batteryLevelText = level === null ? "电量未知" : Math.round(level * 100) + "%";
          this.animationPowerSave = level !== null && level <= 0.20 && !charging;
          this.motionPolicyDetail = this.animationPowerSave
            ? "电量 " + this.batteryLevelText + " 且未充电：已暂停持续动效。"
            : "电量 " + this.batteryLevelText + (charging ? " · 充电中" : "") + "；页面隐藏时暂停持续动效。";
          this.refreshMotionEffects();
        },
        fail: () => {
          if (pageDisposing || policyGeneration !== batteryPolicyGeneration) return;
          this.batteryLevelText = "电量未知";
          this.animationPowerSave = false;
          this.motionPolicyDetail = "电量读取失败；页面隐藏时仍会暂停持续动效。";
          this.refreshMotionEffects();
        },
        complete: () => {},
      });
    } catch (e) {
      if (pageDisposing || policyGeneration !== batteryPolicyGeneration) return;
      this.batteryLevelText = "电量未知";
      this.animationPowerSave = false;
      this.motionPolicyDetail = "电量读取异常；页面隐藏时仍会暂停持续动效。";
      this.refreshMotionEffects();
    }
  },

  handlePhoneMessage(payload) {
    const acceptance = preciseResultAcceptance({
      isRunning: this.isRunning,
      processingStateKey: this.processingStateKey,
      hasPendingRecord: Boolean(this.latestSession()),
    });
    if (!acceptance.allowed) {
      console.log('VMC_PRECISE_RESULT_IGNORED reason=' + acceptance.reason);
      return false;
    }
    const inspected = inspectPreciseResult(payload);
    if (inspected.status === 'degraded') {
      this.preciseReviewReady = false;
      this.preciseReviewText = "手机结果为降级模型，未作为精确复盘";
      this.syncFeedbackText = '需重试';
      if (motionFx) motionFx.setPreciseVisible(false);
      this.preciseStampScale = 1;
      this.preciseStampOpacity = 0;
      this.setProcessingState(PROCESSING_STATES.PENDING_SYNC, this.preciseReviewText);
      this.exportStatusText = "手机结果为降级模型";
      console.log('VMC_PRECISE_RESULT_IGNORED reason=incomplete_scale_set');
      return false;
    }
    const precise = inspected.result;
    if (!precise) {
      console.log('VMC_PRECISE_RESULT_IGNORED reason=missing_precise_result');
      return false;
    }
    this.preciseReviewReady = true;
    this.preciseReviewText = "手机精确结果已确认";
    this.syncFeedbackText = '已回填';
    this.setProcessingState(PROCESSING_STATES.PHONE_PRECISE);
    this.preciseStampScale = 0.72;
    this.preciseStampOpacity = 0;
    if (!this.triggerMotionEffect('precise')) {
      if (motionFx) motionFx.setPreciseVisible(true);
      this.preciseStampScale = 1;
      this.preciseStampOpacity = 1;
    }
    const patch = {
      aiSummaryTitle: "手机精确复盘",
      aiSummarySource: "手机精算",
    };
    if (precise.totalSec !== null) {
      patch.summaryTotal = formatSec(precise.totalSec);
      this.exportTotalText = formatSec(precise.totalSec);
    }
    if (precise.activeSec !== null) patch.summaryActive = formatSec(precise.activeSec);
    if (precise.segmentCount !== null) {
      patch.summarySegments = String(Math.round(precise.segmentCount));
      this.exportSegmentText = String(Math.round(precise.segmentCount));
    }
    if (precise.riskCount !== null) {
      patch.summaryRisk = precise.riskCount > 0 ? Math.round(precise.riskCount) + " 条提醒" : "无风险";
      this.exportRiskText = String(Math.round(precise.riskCount));
    }
    if (precise.segments) {
      patch.timelineRows = segmentRows(precise.segments);
      patch.timelineEmpty = precise.segments.length === 0;
    }
    if (precise.aiSummary) patch.aiSummaryText = compactWatchSummary(precise.aiSummary);
    patchLive(this, patch);
    this.exportStatusText = "精确结果已回填";
    console.log('VMC_PRECISE_RESULT_APPLIED segments=' + (precise.segmentCount === null ? 'unchanged' : precise.segmentCount));
    return true;
  },

  startHealthProvider() {
    if (!healthProvider) {
      healthProvider = new HealthProvider(
        (sample) => this.applyHealthSample(sample),
        (err) => this.applyHealthError(err),
      );
    }
    try {
      healthProvider.start();
      this.serviceHealthText = '订阅中';
    } catch (e) {
      this.serviceHealthText = 'Mock 兜底';
      console.log(`service.health unavailable: ${e.message}`);
    }
  },

  applyHealthSample(sample) {
    if (!sample || !sample.ok) return;
    if (realProvider) realProvider.updateHealth(sample);
    if (sample.dataType === DATA_TYPES.HEART_RATE) {
      this.serviceHealthText = `HR ${Math.round(sample.value)}`;
    } else if (sample.dataType === DATA_TYPES.SPO2) {
      this.serviceHealthText = `SpO₂ ${Math.round(sample.value)}%`;
    } else if (sample.dataType === DATA_TYPES.STRESS) {
      this.serviceHealthText = `压力 ${Math.round(sample.value)}`;
    }
  },

  applyHealthError(err) {
    this.serviceHealthText = err && err.unsupported ? 'Mock 兜底' : 'Mock 兜底';
  },

  applyScene(sceneId, force) {
    if (this.isRunning && !force) {
      this.sceneDesc = '请先停止训练';
      return;
    }
    dataProviderMode = 'mock';
    selectedSceneId = sceneId;
    this.dataSourceText = '演示';
    const scene = getScenario(sceneId);
    this.currentSceneName = scene.name;
    this.sceneDesc = sceneHint(sceneId);
    this.scenePreviewRows = scenePreviewRows(sceneId);
    this.setSceneSelection(sceneId);
    if (mockProvider) mockProvider.selectScene(sceneId);
  },

  useMixed() { this.applyScene('mixed_workout'); },
  useRunning() { this.applyScene('running'); },
  useFatigue() { this.applyScene('fatigue_running'); },
  useJump() { this.applyScene('jump_rope'); },
  useStatic() { this.applyScene('static'); },
  useRealDevice() {
    if (this.isRunning) {
      this.sceneDesc = '请先停止训练';
      return;
    }
    dataProviderMode = 'real';
    selectedSceneId = 'real_device';
    this.currentSceneName = '真机采集';
    this.sceneDesc = sceneHint('real_device');
    this.scenePreviewRows = scenePreviewRows('real_device');
    this.setSceneSelection('real_device');
    this.dataSourceText = '真机';
    if (mockProvider) mockProvider.stop();
  },

  toggleRunning() {
    console.log(`VMC_ACTION_TOGGLE running=${this.isRunning}`);
    if (this.isRunning) this.stopSession();
    else this.startSession();
  },

  startSession(startOffsetSec) {
    if (this.isFinalizing) {
      console.log('VMC_SESSION_START_BLOCKED reason=finalizing');
      return false;
    }
    const startPermission = getSessionStartPermission(this.isDiagnosing);
    if (!startPermission.allowed) {
      patchLive(this, {
        runStatusText: "设备诊断中",
        summaryTip: startPermission.message,
      });
      console.log('VMC_SESSION_START_BLOCKED reason=device_diagnostics');
      return false;
    }
    if (dataProviderMode === 'real') {
      if (!realProvider) realProvider = new RealSensorProvider();
      let capabilities = null;
      try {
        capabilities = realProvider.getCapabilities();
      } catch (e) {
        capabilities = null;
      }
      const realPermission = getRealTrainingPermission(capabilities);
      if (!realPermission.allowed) {
        if (mockProvider) mockProvider.stop();
        realProvider.stop();
        this.isRunning = false;
        this.storageStatusText = '未启动';
        this.dataSourceText = capabilities && capabilities.accelerometer ? 'ACC' : '!';
        this.sceneDesc = realPermission.message;
        this.diagnosticButtonText = '检测';
        this.diagnosticRows = watchDiagnosticRows([
          {
            name: '真实 ACC',
            status: capabilities && capabilities.accelerometer ? '通过' : '失败',
            detail: capabilities && capabilities.accelerometer ? 'ACC 可用' : 'ACC 不可用',
          },
          { name: '真实 GYRO', status: '失败', detail: '公开 JS API 未提供 GYRO' },
        ]);
        this.diagnosticSummaryText = realPermission.message;
        this.diagnosticPassWidth = capabilities && capabilities.accelerometer ? 124 : 18;
        this.setProcessingState(PROCESSING_STATES.WATCH_SCREENING, realPermission.message);
        patchLive(this, Object.assign(createInitialLiveState(), {
          startButtonText: '重试',
          runStatusText: '完整识别未启动',
          runMarkerColor: '#F97316',
          alertStatusText: '不会保存',
          activityEmoji: '!',
          activityName: capabilities && capabilities.accelerometer ? '缺少 GYRO' : 'ACC 不可用',
          activityColor: '#DC2626',
          accText: capabilities && capabilities.accelerometer ? 'ACC 可用·GYRO 不可用' : 'ACC 不可用',
          summaryTip: realPermission.message,
          riskTitle: '真机能力不足',
          riskMessage: realPermission.message,
          riskColor: '#DC2626',
          riskBgColor: '#FEF2F2',
        }));
        console.log('VMC_REAL_SENSOR_BLOCKED reason=' + (capabilities && capabilities.reason ? capabilities.reason : 'capability_unavailable'));
        return false;
      }
    }
    setTrainingScreenOn(true);
    this.resetHistoryClear();
    this.coachToolsOpen = false;
    this.coachToolsButtonText = '场景';
    this.timelineReviewOpen = false;
    this.timelineViewButtonText = '复盘';
    this.cancelAiSummary();
    if (!engine) engine = new MotionEngine();
    if (!inferenceRunner || inferenceRunner.engine !== engine) {
      inferenceRunner = new CooperativeMotionRunner(engine, inferenceSchedule);
    } else {
      inferenceRunner.cancel();
    }
    if (!mockProvider) mockProvider = new MockSensorProvider();
    engine.reset();
    lastResult = null;
    lastSample = null;
    sessionStartMs = Date.now();
    lastAlertAtMs = 0;
    lastAlertKey = '';
    trendSamples = [];
    riskEvents = [];
    lastTrendSecond = -1;
    lastRiskEventAtMs = 0;
    lastRiskEventKey = '';
    lastSummarySnapshot = null;
    lastAnimatedActivityKey = '';
    goalActiveReached = false;
    this.baselineActive = true;
    this.goalActiveText = "本次活跃目标 " + GOAL_ACTIVE_SEC + " 秒";
    this.preciseReviewReady = false;
    this.preciseReviewText = "尚未收到手机精确结果";
    this.syncFeedbackText = '训练中';
    if (motionFx) motionFx.clearTransientEffects(false);
    this.applyMotionFrame(motionNeutralFrame(false));
    this.setProcessingState(PROCESSING_STATES.WATCH_SCREENING);
    this.startHealthProvider();
    this.isRunning = true;
    this.updateMotionChannels();
    this.triggerMotionEffect('start');
    this.diagnosticButtonText = "训练中不可检测";
    patchLive(this, Object.assign(createInitialLiveState(), {
      startButtonText: "停止",
      runStatusText: "识别中",
      runMarkerColor: "#22C55E",
      activityName: "准备中",
      summaryTip: "正在识别运动片段，强度变化会振动提醒。",
      riskTitle: "建立基线",
      riskMessage: "正在收集腕部动作与心率趋势。",
      riskColor: "#64748B",
      riskBgColor: "#F1F5F9",
    }));
    if (dataProviderMode === 'real') {
      if (!realProvider) realProvider = new RealSensorProvider();
      if (mockProvider) mockProvider.stop();
      this.dataSourceText = '真机';
      realProvider.start((batch) => this.handleBatch(batch), { interval: 'game' });
      console.log('VMC_REAL_SENSOR_START');
    } else {
      if (!mockProvider) mockProvider = new MockSensorProvider();
      if (realProvider) realProvider.stop();
      this.dataSourceText = '演示';
      mockProvider.start(selectedSceneId, (batch) => this.handleBatch(batch), { startOffsetSec: startOffsetSec || 0 });
    }
    return true;
  },

  stopSession() {
    if (!this.isRunning) {
      console.log('VMC_SESSION_STOP_IGNORED reason=not_running');
      return false;
    }
    const stopStarted = Date.now();
    this.isRunning = false;
    this.baselineActive = false;
    if (motionFx) motionFx.clearTransientEffects(false);
    this.applyMotionFrame(motionNeutralFrame(false));
    this.updateMotionChannels();
    setTrainingScreenOn(false);
    if (inferenceRunner) inferenceRunner.cancel();
    this.diagnosticButtonText = "检测";
    // Prevent a previous carousel's delayed auto-stop/scene switch from
    // affecting a later session started after the user stopped manually.
    clearDemoSessionTimers();
    if (mockProvider) mockProvider.stop();
    if (realProvider) realProvider.stop();
    if (healthProvider) healthProvider.stop();
    const elapsed = secFromNow(lastSample);

    if (!lastSample || !lastResult || lastResult.warmupFraction < 1 || elapsed < 3) {
      this.storageStatusText = "未保存";
      patchLive(this, {
        startButtonText: "开始",
        runStatusText: "训练时间过短",
        runMarkerColor: "#94A3B8",
        summaryTip: "至少训练 3 秒后再停止，才会生成有效记录。",
      });
      this.setProcessingState(PROCESSING_STATES.WATCH_SCREENING, "训练过短，未生成待同步记录");
      this.applyExportPreview();
      console.log("VMC_SESSION_DISCARD elapsed=" + elapsed);
      return true;
    }

    this.isFinalizing = true;
    this.storageStatusText = '整理中';
    patchLive(this, {startButtonText:'保存中', runStatusText:'训练已停止', runMarkerColor:'#94A3B8'});
    const token = ++stopGeneration;
    const started = stopStarted;
    const result = lastResult, sample = lastSample, risks = riskEvents, trends = trendSamples;
    const record = {sceneId:selectedSceneId, sceneName:this.currentSceneName, segments:result.segments, risks:risks.slice(-8)};
    const active = () => !pageDisposing && token === stopGeneration;
    let summary, review, settled = false;
    const stage = (name, fn) => () => {
      const at = Date.now(); fn();
      console.warn('VMC_STOP_STAGE name=' + name + ' ms=' + (Date.now()-at));
    };
    stopWork.run([
      stage('summary', () => {
        summary = buildSummary(result, elapsed, sample);
        summary.riskCount = risks.length;
        summary.riskLabel = risks.length ? risks[risks.length-1].title : '无风险';
        record.summary = summary;
      }),
      stage('charts', () => {
        summary.activityShares = activityShareRowsFromSummary(summary);
        summary.intensityTrend = intensityTrendRowsFromSamples(trends);
      }),
      stage('review', () => { if (active()) review = this.reviewPatch(summary, true); }),
      stage('metadata', () => {
        if (!active()) return;
        this.preciseReviewReady = false;
        this.preciseReviewText = '尚未收到手机精确结果';
        this.syncFeedbackText = '待回填';
        this.cancelAiSummary();
        this.setProcessingState(PROCESSING_STATES.PENDING_SYNC);
      }),
      stage('view', () => {
        if (!active()) return;
        patchLive(this, Object.assign({
          summaryTotal:formatSec(summary.totalSec), summaryActive:formatSec(summary.activeSec),
          summarySegments:String(summary.segmentCount), intensityTrendRows:summary.intensityTrend,
          summaryTip:'正在保存：活跃 ' + formatSec(summary.activeSec) + '，' + summary.segmentCount + ' 个片段。',
        }, review));
      }),
      stage('save', () => {
        saveSession(record, (persisted) => {
          if (settled) return;
          settled = true;
          console.warn('VMC_SESSION_PERSISTED elapsed_ms=' + (Date.now()-started) + ' persisted=' + persisted);
          if (!active()) return;
          this.isFinalizing = false;
          this.applyHistory(listSessions());
          this.storageStatusText = persisted ? listSessions().length + ' 次记录' : '仅内存保存';
          patchLive(this, {startButtonText:'开始', runStatusText:persisted ? '训练已保存' : '仅内存保存',
            summaryTip:(persisted ? '已保存：活跃 ' : '仅内存：活跃 ') + formatSec(summary.activeSec) + '，自动识别 ' + summary.segmentCount + ' 个片段。'});
          console.log('VMC_SESSION_STOP total=' + summary.totalSec + ' active=' + summary.activeSec + ' segments=' + summary.segmentCount);
          console.warn('VMC_SESSION_FINALIZED elapsed_ms=' + (Date.now()-started) + ' persisted=' + persisted);
        });
      }),
    ], (error) => {
      console.warn('VMC_SESSION_FINALIZE_ERROR ' + error);
      if (active()) {
        this.isFinalizing = false;
        this.storageStatusText = '整理失败';
        patchLive(this, {startButtonText:'开始', runStatusText:'未保存'});
      }
    });
    console.warn('VMC_SESSION_STOP_ACCEPTED');
    return true;
  },

  resetSession() {
    if (this.isFinalizing) return false;
    clearDemoSessionTimers();
    setTrainingScreenOn(false);
    if (inferenceRunner) inferenceRunner.cancel();
    if (mockProvider) mockProvider.stop();
    if (realProvider) realProvider.stop();
    if (healthProvider) healthProvider.stop();
    if (engine) engine.reset();
    lastResult = null;
    lastSample = null;
    sessionStartMs = 0;
    lastAlertAtMs = 0;
    lastAlertKey = "";
    trendSamples = [];
    riskEvents = [];
    lastTrendSecond = -1;
    lastRiskEventAtMs = 0;
    lastRiskEventKey = "";
    lastSummarySnapshot = null;
    lastAnimatedActivityKey = '';
    goalActiveReached = false;
    this.isRunning = false;
    this.baselineActive = false;
    this.goalActiveText = "本次活跃目标 " + GOAL_ACTIVE_SEC + " 秒";
    this.preciseReviewReady = false;
    this.preciseReviewText = "尚未收到手机精确结果";
    this.syncFeedbackText = '待回填';
    this.cancelAiSummary();
    if (motionFx) {
      motionFx.setHeartRate(0);
      motionFx.clearTransientEffects(false);
    }
    this.applyMotionFrame(motionNeutralFrame(false));
    this.updateMotionChannels();
    this.setProcessingState(PROCESSING_STATES.WATCH_SCREENING, "开始后在表端实时初筛");
    patchLive(this, createInitialLiveState());
  },

  loadSessionHistory() {
    this.storageStatusText = '读取中';
    loadSessions((items) => {
      if (!pageDisposing) this.applyHistory(items);
    });
  },

  applyHistory(items) {
    const rows = historyRowsFromSessions(items || listSessions());
    this.historyRows = rows;
    this.historyEmpty = rows.length === 0;
    if (this.historyEmpty && !this.historyClearBusy) this.resetHistoryClear();
    this.storageStatusText = rows.length > 0 ? `${rows.length} 次记录` : '本地存储';
    this.applyExportPreview();
    console.log(`VMC_HISTORY_RENDER count=${rows.length}`);
  },

  clearHistory() {
    if (this.isFinalizing) return false;
    const action = historyClearAction({
      hasItems: !this.historyEmpty,
      armed: this.historyClearArmed,
      busy: this.historyClearBusy,
    });
    if (action === HISTORY_CLEAR_ACTIONS.EMPTY || action === HISTORY_CLEAR_ACTIONS.BUSY) return false;
    if (action === HISTORY_CLEAR_ACTIONS.ARM) {
      this.historyClearArmed = true;
      this.historyClearButtonText = '再按';
      this.historyClearButtonBg = '#FFF0F0';
      this.historyClearButtonColor = '#B53A3A';
      if (historyClearTimer) clearTimeout(historyClearTimer);
      historyClearTimer = setTimeout(() => {
        historyClearTimer = null;
        if (!pageDisposing) this.resetHistoryClear();
      }, 2600);
      return false;
    }
    if (historyClearTimer) clearTimeout(historyClearTimer);
    historyClearTimer = null;
    this.historyClearArmed = false;
    this.historyClearBusy = true;
    this.historyClearButtonText = '…';
    clearSessions((items) => {
      if (pageDisposing) return;
      this.historyClearBusy = false;
      this.resetHistoryClear();
      this.applyHistory(items);
      this.storageStatusText = '已清空';
      this.preciseReviewReady = false;
      this.preciseReviewText = "尚未收到手机精确结果";
      if (motionFx) motionFx.setPreciseVisible(false);
      this.preciseStampScale = 1;
      this.preciseStampOpacity = 0;
      if (!this.isRunning) this.setProcessingState(PROCESSING_STATES.WATCH_SCREENING, "暂无待同步记录");
    });
    return true;
  },

  latestSession() {
    const items = listSessions();
    return items && items.length ? items[0] : null;
  },

  applyExportPreview() {
    const latest = this.latestSession();
    if (!latest) {
      this.exportStatusText = '暂无记录';
      this.exportPreviewText = '停止训练后可同步摘要到手机端。';
      this.exportTotalText = '--';
      this.exportSegmentText = '--';
      this.exportRiskText = '--';
      if (!this.isRunning && !this.syncDiagnosing && !this.syncSending) this.syncFeedbackText = '无记录';
      return;
    }
    const summary = latest.summary || {};
    this.exportStatusText = '摘要已就绪';
    this.exportPreviewText = buildExportPreview(latest);
    this.exportTotalText = formatSec(summary.totalSec || 0);
    this.exportSegmentText = String(summary.segmentCount || 0);
    this.exportRiskText = String(summary.riskCount || 0);
    if (!this.isRunning
      && !this.syncDiagnosing
      && !this.syncSending
      && !this.preciseReviewReady
      && this.processingStateKey !== PROCESSING_STATES.AWAITING_PRECISE) {
      this.syncFeedbackText = '待回填';
    }
    if (!this.isRunning && this.processingStateKey === PROCESSING_STATES.WATCH_SCREENING) {
      this.setProcessingState(PROCESSING_STATES.PENDING_SYNC);
    }
  },

  beginSyncOperation(action) {
    const permission = syncActionPermission({
      action,
      busy: this.isFinalizing || this.syncDiagnosing || this.syncSending,
      isRunning: this.isRunning,
      hasRecord: Boolean(this.latestSession()),
    });
    if (!permission.allowed) {
      this.syncFeedbackText = permission.feedback;
      return 0;
    }
    const generation = ++syncOperationGeneration;
    this.syncDiagnosing = action === 'diagnose';
    this.syncSending = action === 'send';
    this.syncDiagnoseButtonText = this.syncDiagnosing ? '…' : '检测';
    this.syncSendButtonText = this.syncSending ? '…' : '发送';
    this.syncDiagnoseOpacity = 0.56;
    this.syncSendOpacity = 0.56;
    this.syncFeedbackText = action === 'send' ? '发送中' : '检测中';
    if (syncOperationTimer) clearTimeout(syncOperationTimer);
    syncOperationTimer = setTimeout(() => {
      if (pageDisposing || generation !== syncOperationGeneration) return;
      syncOperationGeneration += 1;
      syncOperationTimer = null;
      this.syncDiagnosing = false;
      this.syncSending = false;
      this.syncDiagnoseButtonText = '检测';
      this.syncSendButtonText = '发送';
      this.syncDiagnoseOpacity = 1;
      this.syncSendOpacity = 1;
      this.syncFeedbackText = '可重试';
    }, 5200);
    return generation;
  },

  finishSyncOperation(generation) {
    if (!generation || generation !== syncOperationGeneration) return false;
    if (syncOperationTimer) clearTimeout(syncOperationTimer);
    syncOperationTimer = null;
    this.syncDiagnosing = false;
    this.syncSending = false;
    this.syncDiagnoseButtonText = '检测';
    this.syncSendButtonText = '发送';
    this.syncDiagnoseOpacity = 1;
    this.syncSendOpacity = 1;
    return true;
  },

  diagnoseSync() {
    const generation = this.beginSyncOperation('diagnose');
    if (!generation) return false;
    this.syncStatusText = '检测中';
    diagnosePhoneLink((res) => {
      if (!this.finishSyncOperation(generation)) return;
      this.syncStatusText = res && res.statusText ? res.statusText : '未连接';
      this.syncFeedbackText = this.syncStatusText;
      console.log(`VMC_SYNC_DIAG ok=${res && res.ok} detail=${res && res.detail}`);
    });
    return true;
  },

  sendLatestToPhone() {
    const latest = this.latestSession();
    const generation = this.beginSyncOperation('send');
    if (!generation) return false;
    const now = Date.now();
    if (now - lastSyncSendAtMs < 1200) {
      this.finishSyncOperation(generation);
      this.syncFeedbackText = '请稍候';
      return false;
    }
    lastSyncSendAtMs = now;
    this.exportStatusText = '发送中';
    sendSessionToPhone(latest, (res) => {
      if (!this.finishSyncOperation(generation)) return;
      this.exportStatusText = res && res.statusText ? res.statusText : '发送完成';
      this.syncFeedbackText = res && res.ok ? '等待手机' : (res && res.statusText ? res.statusText : '可重试');
      this.exportPreviewText = buildExportPreview(latest);
      if (res && res.ok) {
        this.preciseReviewReady = false;
        this.preciseReviewText = "已发往手机，等待精确结果";
        if (motionFx) motionFx.setPreciseVisible(false);
        this.preciseStampScale = 1;
        this.preciseStampOpacity = 0;
        this.setProcessingState(PROCESSING_STATES.AWAITING_PRECISE);
      } else {
        this.setProcessingState(PROCESSING_STATES.PENDING_SYNC, "发送未完成，可稍后重试");
      }
      console.log(`VMC_SYNC_SEND ok=${res && res.ok} detail=${res && res.detail}`);
    });
    return true;
  },

  runDiagnostics() {
    const permission = getDiagnosticStartPermission(this.isRunning, this.isDiagnosing);
    if (!permission.allowed) {
      this.diagnosticRows = watchDiagnosticRows([{
        name: '真机诊断',
        status: '边界',
        detail: permission.message,
      }]);
      this.diagnosticSummaryText = permission.message;
      this.diagnosticPassWidth = 18;
      this.diagnosticButtonText = this.isRunning ? '请先停止训练' : '检测中';
      console.log(`VMC_DEVICE_DIAG_BLOCKED running=${this.isRunning} diagnosing=${this.isDiagnosing}`);
      return false;
    }
    this.isDiagnosing = true;
    const generation = ++diagnosticGeneration;
    this.diagnosticButtonText = '检测中';
    this.diagnosticRows = watchDiagnosticRows([{ name: '真机诊断', status: '检测中', detail: '正在读取接口' }]);
    this.diagnosticSummaryText = '检测中';
    this.diagnosticPassWidth = 32;
    if (diagnosticTimer) clearTimeout(diagnosticTimer);
    diagnosticTimer = setTimeout(() => {
      if (pageDisposing || generation !== diagnosticGeneration) return;
      diagnosticGeneration += 1;
      diagnosticTimer = null;
      this.isDiagnosing = false;
      this.diagnosticButtonText = '重试';
      this.diagnosticSummaryText = '检测超时';
      this.diagnosticPassWidth = 18;
    }, 7000);
    try {
      runDeviceDiagnostics((rows) => {
        if (pageDisposing || generation !== diagnosticGeneration) return;
        if (diagnosticTimer) clearTimeout(diagnosticTimer);
        diagnosticTimer = null;
        this.isDiagnosing = false;
        this.diagnosticButtonText = '重新检测';
        const watchRows = watchDiagnosticRows(rows || []);
        const overview = diagnosticOverview(watchRows);
        this.diagnosticRows = watchRows;
        this.diagnosticSummaryText = overview.text;
        this.diagnosticPassWidth = overview.width;
        console.log(`VMC_DEVICE_DIAG count=${this.diagnosticRows.length}`);
      });
      return true;
    } catch (e) {
      if (generation !== diagnosticGeneration) return false;
      if (diagnosticTimer) clearTimeout(diagnosticTimer);
      diagnosticTimer = null;
      this.isDiagnosing = false;
      this.diagnosticButtonText = '重新检测';
      this.diagnosticRows = watchDiagnosticRows([{
        name: '真机诊断',
        status: '失败',
        detail: e && e.message ? e.message : String(e),
      }]);
      this.diagnosticSummaryText = '诊断启动失败';
      this.diagnosticPassWidth = 18;
      console.log(`VMC_DEVICE_DIAG_START_FAIL error=${e && e.message ? e.message : e}`);
      return false;
    }
  },

  aiSummaryPayload(summary, activityRows) {
    const live = liveUpdates.current(this) || createInitialLiveState();
    return {
      summary: summary || lastSummarySnapshot || {},
      activityShareRows: activityRows || live.activityShareRows || [],
      riskEvents,
      sceneName: this.currentSceneName,
    };
  },

  cancelAiSummary() {
    aiSummaryGeneration += 1;
    if (aiSummaryTimer) clearTimeout(aiSummaryTimer);
    aiSummaryTimer = null;
    this.aiSummaryBusy = false;
  },

  refreshAiSummary() {
    if (this.aiSummaryBusy) return false;
    this.aiSummaryBusy = true;
    const generation = ++aiSummaryGeneration;
    patchLive(this, {
      aiSummaryTitle: "生成中",
      aiSummaryButtonText: "请稍候",
    });
    if (aiSummaryTimer) clearTimeout(aiSummaryTimer);
    aiSummaryTimer = setTimeout(() => {
      if (pageDisposing || generation !== aiSummaryGeneration) return;
      aiSummaryTimer = null;
      this.aiSummaryBusy = false;
      patchLive(this, { aiSummaryTitle: '稍后再试', aiSummaryButtonText: '重试' });
    }, 6500);
    requestAiSummary(this.aiSummaryPayload(lastSummarySnapshot), (res) => {
      if (pageDisposing || generation !== aiSummaryGeneration) return;
      if (aiSummaryTimer) clearTimeout(aiSummaryTimer);
      aiSummaryTimer = null;
      this.aiSummaryBusy = false;
      const source = res && res.source ? res.source : "本地总结";
      const title = res && res.ok ? "AI 建议" : "本地建议";
      const text = res && res.text ? res.text : buildLocalAiSummary(this.aiSummaryPayload(lastSummarySnapshot));
      patchLive(this, {
        aiSummarySource: source,
        aiSummaryTitle: title,
        aiSummaryText: compactWatchSummary(text),
        aiSummaryButtonText: "更新建议",
      });
      if (res && res.error) console.log("VMC_AI_SUMMARY_FALLBACK error=" + res.error);
      else console.log("VMC_AI_SUMMARY source=" + source);
    });
    return true;
  },

  recordTrend(result, sample, elapsed, zone) {
    const sec = Math.floor(elapsed || 0);
    if (sec !== lastTrendSecond) {
      lastTrendSecond = sec;
      const features = result && result.latestWindow && result.latestWindow.features ? result.latestWindow.features : {};
      trendSamples.push({
        elapsedSec: sec,
        bpm: sample && sample.heartRate ? Math.round(sample.heartRate) : 0,
        stepCount: sample && sample.stepCount ? sample.stepCount : 0,
        accStd: features.accStd || 0,
        classIdx: result ? result.classIdx : CLASS_BG,
        color: zone && zone.color ? zone.color : "#E5E7EB",
        zoneLabel: zone && zone.label ? zone.label : "--",
      });
      if (trendSamples.length > 120) trendSamples.shift();
    }
    // Keep raw samples for risk analysis and the saved summary. The watch
    // does not display this chart during training, so do not rebuild it here.
  },

  riskPatch(risk, elapsed) {
    if (!risk) return {};
    let alertStatusText = "提醒开启";
    if (risk.level === "danger") alertStatusText = "风险提醒";
    else if (risk.level === "warning") alertStatusText = "强度提醒";

    const shouldRecord = risk.key && (risk.level === "danger" || risk.key === "fatigue_running");
    const now = Date.now();
    if (shouldRecord && (risk.key !== lastRiskEventKey || now - lastRiskEventAtMs > 12000)) {
      lastRiskEventKey = risk.key;
      lastRiskEventAtMs = now;
      riskEvents.push({
        time: formatSec(elapsed),
        key: risk.key,
        title: risk.title,
        message: risk.message,
        color: risk.color,
      });
      if (riskEvents.length > 8) riskEvents.shift();
      console.log("VMC_RISK_EVENT key=" + risk.key + " title=" + risk.title + " elapsed=" + formatSec(elapsed));
    }
    return {
      riskTitle: risk.title,
      riskMessage: risk.message,
      riskColor: risk.color,
      riskBgColor: risk.bgColor,
      alertStatusText,
      summaryRisk: riskEvents.length > 0 ? riskEvents.length + " 条提醒" : "无风险",
    };
  },

  reviewPatch(summary, includeAi) {
    lastSummarySnapshot = summary;
    const activityRows = includeAi ? (summary.activityShares || activityShareRowsFromSummary(summary)) : null;
    const patch = {
      summaryActiveShare: activeShareText(summary),
      summaryRisk: riskEvents.length > 0 ? riskEvents.length + " 条提醒" : "无风险",
    };
    if (activityRows) patch.activityShareRows = activityRows;
    const live = liveUpdates.current(this) || createInitialLiveState();
    if (includeAi && live.aiSummarySource !== "velaclaw") {
      patch.aiSummaryTitle = "本地建议";
      patch.aiSummarySource = "本地总结";
      patch.aiSummaryText = compactWatchSummary(buildLocalAiSummary(this.aiSummaryPayload(summary, activityRows)));
    }
    return patch;
  },

  alertPatch(result, sample, zone, risk) {
    const alert = pulseWorkoutAlert(result, sample, zone, { now: Date.now(), lastAlertAtMs, lastAlertKey, risk });
    if (!alert || !alert.triggered) return {};
    lastAlertAtMs = Date.now();
    lastAlertKey = alert.key;
    if (shouldShakeRiskCard(risk, alert)) this.triggerMotionEffect('risk');
    console.log("VMC_VIBRATE key=" + alert.key + " mode=" + alert.mode + " available=" + alert.available);
    return {
      alertStatusText: alert.available === false ? "模拟提醒" : (alert.mode === "long" ? "长振提醒" : "短振提醒"),
      summaryTip: alert.available === false ? alert.message + "（模拟器未响应振动）" : alert.message,
    };
  },

  handleBatch(batch) {
    if (!this.isRunning || !batch || batch.length === 0 || !engine) return;
    const receivedAtMs = Date.now();
    const fallbackStart = receivedAtMs - Math.max(0, batch.length - 1) * SAMPLE_PERIOD_MS;
    const safeBatch = batch.map((sample, idx) => Object.assign({}, sample || {}, {
      accX: finiteNumber(sample && sample.accX, 0),
      accY: finiteNumber(sample && sample.accY, 0),
      accZ: finiteNumber(sample && sample.accZ, 9.81),
      gyroX: finiteNumber(sample && sample.gyroX, 0),
      gyroY: finiteNumber(sample && sample.gyroY, 0),
      gyroZ: finiteNumber(sample && sample.gyroZ, 0),
      heartRate: Math.max(0, finiteNumber(sample && sample.heartRate, 0)),
      spo2: Math.max(0, finiteNumber(sample && sample.spo2, 0)),
      stress: Math.max(0, finiteNumber(sample && sample.stress, 0)),
      stepCount: Math.max(0, finiteNumber(sample && sample.stepCount, 0)),
      timeStamp: finiteNumber(sample && sample.timeStamp, fallbackStart + idx * SAMPLE_PERIOD_MS),
    }));
    if (!inferenceRunner || inferenceRunner.engine !== engine) {
      inferenceRunner = new CooperativeMotionRunner(engine, inferenceSchedule);
    }
    inferenceRunner.submit(safeBatch, { receivedAtMs }, (result, processedBatch, meta) => {
      if (!this.isRunning) return;
      this.applyInferenceResult(processedBatch, result, meta && meta.startedAtMs);
    });
  },

  inferenceViewPatch() {
    if (!lastResult || !this.pageVisible) return {};
    // Build only the visible page's rows, including immediately on navigation.
    // Hidden pages retain widgets but need no sorting, formatting or diffing.
    if (this.pageState.index === 1) {
      const rows = probabilityRows(lastResult.smoothedProbs || lastResult.probs);
      return { coachClassRows: topCoachRows(rows) };
    } else if (this.pageState.index === 2) {
      const rows = segmentRows(lastResult.segments);
      return { timelineRows: rows, timelineEmpty: rows.length === 0 };
    }
    return {};
  },

  applyInferenceResult(safeBatch, result, startedAtMs) {
    if (!this.isRunning || !safeBatch || safeBatch.length === 0 || !result) return;
    const batchStarted = Number.isFinite(startedAtMs) ? startedAtMs : Date.now();
    lastSample = safeBatch[safeBatch.length - 1];
    const engineMs = (result.classifierMs || 0) + (result.trlMs || 0);
    lastResult = result;
    const elapsed = secFromNow(lastSample);
    const zone = classifyHrZone(lastSample.heartRate);
    this.recordTrend(result, lastSample, elapsed, zone);
    const risk = analyzeWorkoutRisk(result, lastSample, zone, trendSamples);
    const riskUi = this.riskPatch(risk, elapsed);
    let activityUi;
    if (result.warmupFraction < 1) {
      if (!this.baselineActive) {
        this.baselineActive = true;
        this.updateMotionChannels();
      }
      activityUi = {
        activityEmoji: "动",
        activityName: "准备 " + Math.round(result.warmupFraction * 100) + "%",
        activityColor: "#111111",
        confidenceText: "--",
        runStatusText: "建立动作基线",
        coachTip: "正在学习当前腕部动作，保持自然运动。",
      };
    } else {
      if (this.baselineActive) {
        this.baselineActive = false;
        this.updateMotionChannels();
      }
      const activityKey = String(result.classIdx);
      if (activityKey !== lastAnimatedActivityKey) {
        lastAnimatedActivityKey = activityKey;
        this.triggerMotionEffect('activity');
      }
      activityUi = {
        activityEmoji: classEmoji(result.classIdx),
        activityName: result.className,
        activityColor: result.classIdx === CLASS_BG ? "#111111" : classColor(result.classIdx),
        confidenceText: pct(result.confidence),
        runStatusText: result.classIdx === CLASS_BG ? "恢复 / 静止" : "正在运动",
        coachTip: risk && (risk.level === "warning" || risk.level === "danger") ? risk.message : buildCoachTip(result, lastSample),
      };
    }
    this.updateMotionChannels();

    const alertUi = this.alertPatch(result, lastSample, zone, risk);
    const summary = buildSummary(result, elapsed, lastSample);
    if (!goalActiveReached && summary.activeSec >= GOAL_ACTIVE_SEC) {
      goalActiveReached = true;
      this.goalActiveText = "本次活跃目标 " + GOAL_ACTIVE_SEC + " 秒 · 已达成";
      this.triggerMotionEffect('goal');
    }
    const reviewUi = this.reviewPatch(summary, false);
    const uiStarted = Date.now();
    const live = patchLive(this, Object.assign({
      elapsedText: formatSec(elapsed),
      hrText: lastSample.heartRate > 0 ? String(Math.round(lastSample.heartRate)) : "--",
      stepText: String(Math.round(lastSample.stepCount || 0)),
      accText: lastSample.accX.toFixed(1) + " / " + lastSample.accY.toFixed(1) + " / " + lastSample.accZ.toFixed(1),
      zoneText: zone.label,
      zoneColor: zone.color,
      zoneWidth: zoneBarWidth(zone.level),
      summaryTotal: formatSec(summary.totalSec),
      summaryActive: formatSec(summary.activeSec),
      summarySegments: String(summary.segmentCount),
    }, riskUi, activityUi, reviewUi, alertUi, this.inferenceViewPatch()));

    const now = Date.now();
    if (now - lastProbeLogMs > 1000) {
      lastProbeLogMs = now;
      console.log("VMC_DYNAMIC_UI activity=" + live.activityName + " confidence=" + live.confidenceText + " hrText=" + live.hrText + " stepText=" + live.stepText + " accText=" + live.accText + " zoneText=" + live.zoneText + " elapsed=" + live.elapsedText + " engineMs=" + engineMs + " classifierMs=" + (result.classifierMs || 0) + " trlMs=" + (result.trlMs || 0) + " uiMs=" + (now - uiStarted) + " computeMs=" + (now - batchStarted) + " skipped=" + (result.skippedWindows || 0));
    }
  },
};
</script>

<style>
.swiper {
  width: 100%;
  height: 100%;
  background-color: #f5f5f5;
  indicator-color: #d8d8d8;
  indicator-selected-color: #ff6900;

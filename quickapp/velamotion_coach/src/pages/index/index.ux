  border-radius: 15px;
  background-color: #111111;
  color: #ffffff;
  font-size: 12px;
  text-align: center;
  z-index: 9;
}
.global-stop {
  position: absolute;
  left: 145px;
  top: 5px;
  width: 96px;
  height: 30px;
  border-radius: 15px;
  background-color: #dc2626;
  color: #ffffff;
  font-size: 12px;
  text-align: center;
  z-index: 11;
}
.screen {
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  background-color: #f5f5f5;
}
.app-head {
  width: 400px;
  height: 44px;
  margin-top: 40px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.title-block {
  width: 250px;
  height: 44px;
  flex-direction: column;
}
.app-title {
  height: 28px;
  color: #111111;
  font-size: 25px;
  font-weight: bold;
}
.app-subtitle {
  height: 16px;
  margin-top: 1px;
  color: #8a8a8a;
  font-size: 12px;
}
.mode-pill,
.alert-chip {
  height: 28px;
  border-radius: 14px;
  background-color: #fff1e8;
  color: #ff6900;
  font-size: 12px;
  text-align: center;
}
.mode-pill {
  width: 86px;
}
.state-card,
.metric-card,
.selected-card,
.ai-card,
.timeline-card,
.risk-card,
.summary-card,
.ai-summary-card,
.history-card,
.sync-card,
.diagnostic-card {
  width: 400px;
  height: 318px;
  margin-top: 8px;
  padding: 14px;
  border-radius: 24px;
  background-color: #ffffff;
  flex-direction: column;
}
.diagnostic-card {
  height: 292px;
}
.sync-state {
  width: 372px;
  height: 44px;
  border-radius: 18px;
  background-color: #f7f7f7;
  flex-direction: row;
  align-items: center;
  margin-bottom: 8px;
}
.sync-label {
  width: 92px;
  height: 22px;
  margin-left: 14px;
  color: #999999;
  font-size: 13px;
}
.sync-value {
  width: 246px;
  height: 22px;
  color: #111111;
  font-size: 14px;
  text-align: right;
}
.export-preview {
  width: 372px;
  height: 128px;
  border-radius: 18px;
  background-color: #fff7f0;
  color: #555555;
  font-size: 12px;
  padding: 12px;
}
.sync-buttons {
  width: 372px;
  height: 44px;
  margin-top: 12px;
  flex-direction: row;
  justify-content: center;
}
.mini-btn {
  width: 132px;
  height: 38px;
  margin-left: 8px;
  margin-right: 8px;
  border-radius: 19px;
  background-color: #ffffff;
  color: #111111;
  font-size: 14px;
}
.primary-mini {
  background-color: #ff6900;
  color: #ffffff;
}
.diag-row {
  width: 372px;
  height: 34px;
  margin-bottom: 2px;
  border-radius: 16px;
  background-color: #f7f7f7;
  flex-direction: row;
  align-items: center;
}
.diag-name {
  width: 86px;
  height: 18px;
  margin-left: 10px;
  color: #111111;
  font-size: 12px;
  font-weight: bold;
}
.diag-status {
  width: 46px;
  height: 18px;
  color: #ff6900;
  font-size: 12px;
  text-align: center;
}
.diag-detail {
  width: 218px;
  height: 28px;
  color: #777777;
  font-size: 10px;
}

.privacy-card {
  background-color: #ffffff;
  border-radius: 24px;
}
.state-card {
  width: 400px;
  height: 228px;
  margin-top: 10px;
  padding: 14px;
}
.state-top {
  width: 372px;
  height: 28px;
  flex-direction: row;
  align-items: center;
}
.state-dot {
  width: 18px;

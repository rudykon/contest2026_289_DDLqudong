/* Code-native motion buddy and transform/opacity-only event transitions. */
.buddy-zone {
  position: relative;
  width: 60px;
  height: 58px;
}
.activity-buddy-pop,
.heart-buddy-pulse,
.motion-buddy {
  width: 48px;
  height: 48px;
}
.activity-buddy-pop {
  position: absolute;
  left: 5px;
  top: 0;
  transform-origin: 24px 24px;
  transition-property: transform, opacity;
  transition-duration: 110ms;
  transition-timing-function: ease-out;
}
.heart-buddy-pulse {
  transform-origin: 24px 24px;
  transition-property: transform;
  transition-duration: 120ms;
  transition-timing-function: ease-out;
}
.motion-buddy {
  border-radius: 18px;
  background-color: #d9f7ed;
  flex-direction: column;
  align-items: center;
  transform-origin: 24px 24px;
  transition-property: transform;
  transition-duration: 1200ms;
  transition-timing-function: ease-in-out;
}
.buddy-eye-row {
  width: 34px;
  height: 13px;
  margin-top: 6px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.buddy-eye {
  width: 5px;
  height: 7px;
  border-radius: 3px;
  background-color: #155e75;
}
.buddy-face-row {
  width: 40px;
  height: 24px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.buddy-cheek {
  width: 7px;
  height: 5px;
  border-radius: 3px;
  background-color: #fb7185;
}
.buddy-activity {
  width: 22px;
  height: 22px;
  color: #0369a1;
  font-size: 15px;
  font-weight: bold;
  text-align: center;
}
.baseline-dots {
  position: absolute;
  left: 15px;
  top: 50px;
  width: 30px;
  height: 8px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.baseline-dot {
  width: 6px;
  height: 6px;
  border-radius: 3px;
  background-color: #38bdf8;
  transition-property: transform, opacity;
  transition-duration: 140ms;
  transition-timing-function: ease-in-out;
}
.activity-name {
  transform-origin: 0 16px;
  transition-property: transform, opacity;
  transition-duration: 110ms;
  transition-timing-function: ease-out;
}
.heart-value {
  transform-origin: 34px 11px;
  transition-property: transform;
  transition-duration: 120ms;
  transition-timing-function: ease-out;
}
.coach-box,
.coach-live-row {
  transition-property: transform;
  transition-duration: 60ms;
  transition-timing-function: linear;
}
.process-pulse {
  transition-property: transform, opacity;
  transition-duration: 1200ms;
  transition-timing-function: ease-in-out;
}
.sync-link-dot {
  transition-property: opacity;
  transition-duration: 180ms;
  transition-timing-function: ease-in-out;
}
.start-action {
  position: relative;
  width: 400px;
  height: 38px;
  margin-top: 6px;
  align-items: center;
  justify-content: center;
}
.start-primary-btn {
  width: 400px;
  height: 38px;
  margin-top: 0;
  transform-origin: 200px 19px;
  transition-property: transform, opacity;
  transition-duration: 70ms;
  transition-timing-function: ease-out;
}
.start-ring {
  position: absolute;
  left: 181px;
  top: 0;
  width: 38px;
  height: 38px;
  border-radius: 19px;
  background-color: #ff8a4c;
  align-items: center;
  justify-content: center;
  transform-origin: 19px 19px;
  transition-property: transform, opacity;
  transition-duration: 70ms;
  transition-timing-function: ease-out;
  z-index: 4;
}
.start-ring-core {
  width: 26px;
  height: 26px;
  border-radius: 13px;
  background-color: #ffffff;
}
.goal-stars {
  position: absolute;
  left: 120px;
  top: 82px;
  width: 240px;
  height: 66px;
  transform-origin: 120px 33px;
  transition-property: transform;
  transition-duration: 100ms;
  transition-timing-function: ease-out;
  z-index: 20;
}
.goal-star {
  position: absolute;
  top: 2px;
  width: 28px;
  height: 28px;
  color: #fb7185;
  font-size: 22px;
  text-align: center;
  transition-property: transform, opacity;
  transition-duration: 100ms;
  transition-timing-function: ease-out;
}
.goal-star-left { left: 76px; }
.goal-star-top { left: 106px; color: #38bdf8; }
.goal-star-right { left: 136px; color: #34d399; }
.goal-stars-text {
  position: absolute;
  left: 46px;
  top: 34px;
  width: 148px;
  height: 26px;
  border-radius: 13px;
  background-color: #ffffff;
  color: #047857;
  font-size: 12px;
  font-weight: bold;
  text-align: center;
  transition-property: opacity;
  transition-duration: 100ms;
  transition-timing-function: ease-out;
}
.precise-stamp {
  transform-origin: 188px 13px;
  transition-property: transform, opacity;
  transition-duration: 160ms;
  transition-timing-function: ease-out;
}

/* Mint-soda companion visual system: quiet surfaces, friendly hierarchy. */
.swiper,
.screen {
  background-color: #F4FAF7;
}
.swiper {
  indicator-color: #CFE3DA;
  indicator-selected-color: #FF7A3D;
}
.nav-next {
  left: 352px;
  top: 5px;
  width: 44px;
  height: 30px;
  border-radius: 15px;
  background-color: #E3F5EE;
  color: #16755A;
  font-size: 24px;
  font-weight: bold;
}
.global-stop {
  left: 145px;
  top: 5px;
  width: 96px;
  height: 30px;
  background-color: #FFF0F0;
  color: #B53A3A;
  font-size: 12px;
  font-weight: bold;
}
.app-head {
  width: 400px;
  height: 46px;
  margin-top: 36px;
}
.title-block {
